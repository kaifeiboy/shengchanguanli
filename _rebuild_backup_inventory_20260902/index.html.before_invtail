    const orig = dhAnnoState.origAnno;
    const s = dhAnnoState.anno[dhAnnoState.editingIdx];
    if (dhAnnoState.dragHandle){
      // 调整大小
      if (s.type === 'rect' || s.type === 'ellipse'){
        const dx = p.x - dhAnnoState.start.x;
        const dy = p.y - dhAnnoState.start.y;
        const h = dhAnnoState.dragHandle;
        const origW = orig.w, origH = orig.h;
        const origX = orig.x, origY = orig.y;
        if (h === 'tl') { s.w = origW - dx; s.h = origH - dy; s.x = origX + dx; s.y = origY + dy; }
        else if (h === 'tr') { s.w = origW + dx; s.h = origH - dy; s.y = origY + dy; }
        else if (h === 'bl') { s.w = origW - dx; s.h = origH + dy; s.x = origX + dx; }
        else if (h === 'br') { s.w = origW + dx; s.h = origH + dy; }
