  const drawN = (s) => {
    x.strokeStyle = s.color; x.fillStyle = s.color; x.lineWidth = Math.max(1, s.size); x.lineCap = 'round'; x.lineJoin = 'round';
    if (s.type === 'rect') x.strokeRect(s.x, s.y, s.w, s.h);
    else if (s.type === 'ellipse'){ x.beginPath(); x.ellipse(s.x + s.w / 2, s.y + s.h / 2, Math.abs(s.w) / 2, Math.abs(s.h) / 2, 0, 0, Math.PI * 2); x.stroke(); }
    else if (s.type === 'arrow') drawArrow(x, s.x1, s.y1, s.x2, s.y2, s.color, Math.max(1, s.size));
    else if (s.type === 'free'){ x.beginPath(); s.points.forEach((p, i) => i ? x.lineTo(p[0], p[1]) : x.moveTo(p[0], p[1])); x.stroke(); }
    else if (s.type === 'text'){ x.font = (s.font || Math.min(Math.max(24, st.natW * 0.04 * (s.size / 4)), st.natW * 0.1)) + 'px sans-serif'; x.textBaseline = 'top'; x.fillText(s.text, s.x, s.y); }
  };
  st.anno.forEach(drawN);
  cv.toBlob(b => {
