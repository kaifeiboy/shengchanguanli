function drawArrow(ctx, x1, y1, x2, y2, color, lw){
  ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineCap = 'round';
  ctx.lineWidth = Math.max(1, lw * 0.6);  // 尾部稍细
  const ang = Math.atan2(y2 - y1, x2 - x1), len = Math.hypot(x2 - x1, y2 - y1);
  const headLen = Math.max(len * 0.35, lw * 4), headW = headLen * 0.85;  // 头部大三角形
  const shaftEndX = x2 - headLen * Math.cos(ang), shaftEndY = y2 - headLen * Math.sin(ang);
  // 尾部细线
  ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(shaftEndX, shaftEndY); ctx.stroke();
  // 头部大三角形（实心）
  ctx.beginPath(); ctx.moveTo(x2, y2);
  ctx.lineTo(x2 - headLen * Math.cos(ang) - headW/2 * Math.sin(ang), y2 - headLen * Math.sin(ang) + headW/2 * Math.cos(ang));
  ctx.lineTo(x2 - headLen * Math.cos(ang) + headW/2 * Math.sin(ang), y2 - headLen * Math.sin(ang) - headW/2 * Math.cos(ang));
  ctx.closePath(); ctx.fill();
}
