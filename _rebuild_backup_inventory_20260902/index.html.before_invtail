    const ids = Object.keys(dhAnnoState.pointers);
    if (ids.length >= 2){
      const a = dhAnnoState.pointers[ids[0]], b = dhAnnoState.pointers[ids[1]];
      const dist = Math.hypot(a.x - b.x, a.y - b.y);
      const midx = (a.x + b.x) / 2, midy = (a.y + b.y) / 2;
      const z0 = dhAnnoState.gZoom0;
      const maxZoom = Math.max(1, Math.min(12, 1 / (dhAnnoState.scale || 1)));
      const z = Math.max(1, Math.min(maxZoom, z0 * dist / (dhAnnoState.gDist0 || 1)));
