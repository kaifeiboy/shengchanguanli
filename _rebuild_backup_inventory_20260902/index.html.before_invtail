const DH_MODEL_COLORS = ['#4472C4','#ED7D31','#70AD47','#FFC000','#7030A0','#E84C3D','#2E9BD9','#C00000','#00B0F0','#7F7F7F'];

// Canvas 堆叠柱状图：X=拉线；单柱=该拉线当月不良总单数，柱内按型号分段着色（颜色=型号）；
// 每个拉线的型号说明（色块+型号名）放置在该拉线正下方（不再使用集中式文本图例）。
function dhDrawAnalysisChart(r){
  const data = r.data || [], lines = r.lines || [], models = r.models || [];
  const colorOf = {};
  models.forEach((m, i) => { colorOf[m] = DH_MODEL_COLORS[i % DH_MODEL_COLORS.length]; });
  const groups = {};
  data.forEach(d => { (groups[d.line] = groups[d.line] || []).push(d); });
  const byModel = (a, b) => (models.indexOf(a.model) - models.indexOf(b.model));
  const canvas = $('#dhAnCanvas');
  const dpr = window.devicePixelRatio || 1;
  const cssW = canvas.clientWidth || 320;
  const cssH = 300;
  canvas.width = cssW * dpr; canvas.height = cssH * dpr;
  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, cssW, cssH);
  // 型号文本折行：按 Canvas 实测宽度切行（规则与 docx _wrap_label 一致：完整显示不截断）
  const wrapTxt = (txt, maxW) => {
    ctx.font = '11px sans-serif';
    const out = []; let cur = '';
    for (const ch of String(txt || '')){
      if (cur && ctx.measureText(cur + ch).width > maxW){ out.push(cur); cur = ch; }
      else cur += ch;
    }
    if (cur) out.push(cur);
    return out.length ? out : [''];
  };
  // 底部标注区高度：按每拉线"型号折行后总行数"的最大值定（每行 15px，至少 1 行/型号）
  const plotW0 = cssW - 48;
  const slot0 = plotW0 / Math.max(1, lines.length);
  const textMaxW = slot0 - 26;
  const maxRows = Math.max.apply(null, lines.map(line => {
    const items = (groups[line] || []).slice().sort(byModel);
    return items.reduce((s, d) => s + wrapTxt(d.model, textMaxW).length, 0);
  })) || 0;
  const M = { l: 34, r: 14, t: 16, b: 58 + maxRows * 15 };
  canvas.style.height = cssH + 'px';
  const plotW = cssW - M.l - M.r, plotH = cssH - M.t - M.b;
  const maxTotal = Math.max.apply(null, data.map(d => d.total)) || 1;
  const yMax = Math.max(5, Math.ceil(maxTotal / 5) * 5);
  // 网格 + Y 轴
  ctx.font = '11px sans-serif';
  ctx.fillStyle = '#64748b';
  ctx.strokeStyle = '#e2e8f0'; ctx.lineWidth = 1;
  for (let i = 0; i <= 5; i++){
    const y = M.t + plotH - (i / 5) * plotH;
    ctx.beginPath(); ctx.moveTo(M.l, y); ctx.lineTo(M.l + plotW, y); ctx.stroke();
    ctx.fillText(String(Math.round(yMax * i / 5)), 4, y + 4);
  }
  const groupSlot = plotW / Math.max(1, lines.length);
  // 堆叠柱状图：每根柱=该拉线当月不良总单数，柱内按型号分段着色（颜色=型号）
  lines.forEach((line, gi) => {
    const items = (groups[line] || []).slice().sort(byModel);
    const gx = M.l + groupSlot * gi;
    const gw = groupSlot - 8;
    if (items.length === 0) return;
    const barW = Math.min(46, gw * 0.55);
    const cx = gx + gw / 2;
    const x = cx - barW / 2;
    const baseY = M.t + plotH;
    let acc = 0;
    items.forEach(d => {
      const h = (d.total / yMax) * plotH;
      ctx.fillStyle = colorOf[d.model] || '#999';
      ctx.fillRect(x, baseY - acc - h, barW, h);
      acc += h;
    });
    // 柱顶总单数标签
    const total = items.reduce((s, d) => s + d.total, 0);
    if (total > 0){
      ctx.fillStyle = '#1e293b';
      ctx.font = 'bold 11px sans-serif';
      ctx.fillText(String(total), cx, baseY - acc - 4);
      ctx.font = '11px sans-serif';
    }
    // 柱下标注（恢复原版式）：拉线名（6 字符截断）+ 型号 色块+名称（完整显示，超宽自动折行）
    ctx.textAlign = 'center';
    ctx.font = '11px sans-serif';
    let lbl = line;
    if (lbl.length > 6) lbl = lbl.slice(0, 5) + '…';
    const labelY = cssH - M.b + 13;
    ctx.fillStyle = '#334155';
    ctx.fillText(lbl, cx, labelY);
    let ry = labelY + 16;
    items.forEach(d => {
      const ws = wrapTxt(d.model, textMaxW);
      ws.forEach((ln, li) => {
        const y = ry + li * 15;
        if (li === 0){
          ctx.fillStyle = colorOf[d.model] || '#999';
          ctx.fillRect(cx - 26, y - 8, 9, 9);
        }
        ctx.fillStyle = '#475569';
        ctx.textAlign = 'left';
        ctx.fillText(ln, cx - 13, y);
      });
      ry += ws.length * 15;
    });
  });
  // 型号说明已随柱下标注展示，移除集中式文本图例
  $('#dhAnLegend').innerHTML = '';
}

