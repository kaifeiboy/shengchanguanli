<script>
// ---- 全局状态 ----
const $ = (s) => document.querySelector(s);
let curDrawing = null;          // 当前选中的图纸
let lastPhotoFile = null;        // 最近一次比对用的照片（供差异标记复用）
let pendingAction = null;       // 'compare' | 'detail'（选图纸弹层用途分支）
let modulesCache = [];          // 加载的模块列表

// ---- 页面导航历史栈 ----
// 设计原则：_navBack 与手势返回走同一条路径（浏览器历史回退 + popstate统一同步）
// _navPush 与 pushState 一一对应；popstate 根据 location.hash 在栈中定位并 slice
let _navStack = [];  // [{key, title, render, back}]

function _navPush(key, title, render, back){
  _navStack.push({key, title, render, back});
  history.pushState({key}, '', '#' + key);
  _updateNavTitle(title);
}

function _isOverlayOpen(){
  return ['#overlay','#sheet','#toolOverlay','#toolSheet','#menuOverlay','#drawer']
    .some(function(sel){ var el=$(sel); return el && el.classList.contains('show'); });
}
function _closeAnyOverlay(){
  var closed=false;
  ['#overlay','#sheet','#toolOverlay','#toolSheet','#menuOverlay','#drawer'].forEach(function(sel){
    var el=$(sel); if(el && el.classList.contains('show')){ el.classList.remove('show'); closed=true; }
  });
  return closed;
}
// 左缘右滑返回手势（与顶部 #pageBack 走同一条 _navBack 路径，逐级返回）
function initSwipeBack(){
  var sx=0, sy=0, tracking=false, startEl=null, W=window.innerWidth, back=false;
  var app = $('#appWrap') || document.body;
  app.addEventListener('touchstart', function(e){
    if(e.touches.length!==1){ tracking=false; return; }
    var t=e.touches[0]; sx=t.clientX; sy=t.clientY; tracking=true; back=false;
    startEl = document.elementFromPoint(sx, sy);
  }, {passive:true});
  app.addEventListener('touchmove', function(e){
    if(!tracking) return;
    var dx=e.touches[0].clientX-sx, dy=e.touches[0].clientY-sy;
    if(!back){
      // 仅在「左缘起手 + 明显横向右滑」时接管，其余（纵向滚动/普通横向）不干预
      if(sx <= W*0.35 && dx > 14 && dx > Math.abs(dy)*1.6){ back=true; }
      else if(Math.abs(dx) > 14){ tracking=false; return; }
    }
    // 关键：吃掉系统原生边缘返回手势，避免「一次滑动回退两级」(自定手势+系统返回 双触发)
    if(back && e.cancelable) e.preventDefault();
  }, {passive:false});
  app.addEventListener('touchend', function(e){
    if(!tracking) return; tracking=false;
    if(!back) return;
    var t=e.changedTouches[0];
    var dx=t.clientX-sx, dy=t.clientY-sy;
    if(dx < 90 || dx < Math.abs(dy)*1.6) return;
    var el = startEl;                            // 画布/输入控件上不触发返回
    if(el && el.closest && (el.closest('canvas') || el.closest('input') || el.closest('textarea') || el.closest('select'))) return;
    _navBack();
  }, {passive:true});
}
function _navBack(){
  // 优先关闭当前打开的弹层/抽屉（选择图纸、管理、更多等），再走历史回退
  if (_closeAnyOverlay()) return;
  if (_navStack.length <= 1) return;  // 已在首页，不再回退
  // 只触发浏览器历史回退，栈同步与渲染由 popstate 统一处理
  history.back();
}

// popstate 统一处理器：根据当前 hash 同步导航栈并渲染
function _navSyncFromHash(){
  var currentHash = window.location.hash || '#home';
  var idx = -1;
  for (var i = _navStack.length - 1; i >= 0; i--){
    if ('#' + _navStack[i].key === currentHash){ idx = i; break; }
  }
  if (idx > 0){
    // 在栈中找到（含中间位置），裁剪到该层
    _navStack = _navStack.slice(0, idx + 1);
    var prev = _navStack[_navStack.length - 1];
    if (prev){
      $('#pageBack').style.display = 'inline';
      prev.render();
      _updateNavTitle(prev.title);
    }
  } else {
    // idx<=0（首页）或找不到（超出应用）：回到平台首页
    if (_navStack.length === 0) _navStack = [{key:'home', title:'生产管理', render:renderPlatformHome, back:null}];
    _navStack = [_navStack[0]];
    $('#pageBack').style.display = 'none';
    renderPlatformHome();
    _updateNavTitle('生产管理');
  }
}

function _updateNavTitle(title){
  $('#pageTitle').textContent = title;
}

function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),2200); }
function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
// Encode each path segment separately so '/' stays as path separator (security/route requirement)
function encodeVP(p){ return p.split('/').map(s=>encodeURIComponent(s)).join('/'); }

// ---- 页面加载入口 ----
async function loadModules(){
  try{
    const mods = await (await fetch('api/modules')).json();
    modulesCache = mods || [];
  }catch(e){ modulesCache = []; }
  // 监听系统返回手势/浏览器返回：统一由 _navSyncFromHash 处理
  window.addEventListener('popstate', function(e){
    _navSyncFromHash();
  });
  // 左缘右滑返回手势
  initSwipeBack();
  // 初始化首页
  _navStack = [];
  $('#pageBack').style.display = 'none';
  _navPush('home', '生产管理', renderPlatformHome, null);
  renderPlatformHome();
}

// ---- 首页：模块卡片列表 ----
