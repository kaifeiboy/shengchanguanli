function unbindExtractList(r){
  if (!r) return [];
  if (Array.isArray(r)) return r;
  if (Array.isArray(r.list)) return r.list;
  if (r.data && Array.isArray(r.data.list)) return r.data.list;
  if (r.data && Array.isArray(r.data)) return r.data;
  return [];
}

// 时间完整显示：YYYY-MM-DD HH:MM:SS（保留年份，避免跨年时歧义）
function unbindFormatTime(t){
  if (!t) return '-';
  const s = String(t).replace('T',' ').replace(/-/g,'/');
  const d = new Date(s);
  if (isNaN(d.getTime())) return String(t);
  const Y = String(d.getFullYear()).padStart(4,'0');
  const M = String(d.getMonth()+1).padStart(2,'0');
  const D = String(d.getDate()).padStart(2,'0');
  const h = String(d.getHours()).padStart(2,'0');
  const m = String(d.getMinutes()).padStart(2,'0');
  const sec = String(d.getSeconds()).padStart(2,'0');
  return `${Y}-${M}-${D} ${h}:${m}:${sec}`;
}

