function invCloseOcrLayer(){
  if (_invOcrOverlay){ _invOcrOverlay.remove(); _invOcrOverlay = null; }
  _invOcrTarget = null;
  _invOcrBoxes = [];
}

async function invOcrLayerFileChange(e){
  const file = e.target.files[0]; if (!file) return;
  const fd = new FormData(); fd.append('file', file);
  toast('透视矫正中…');
  try {
    const r = await (await fetch(invAPI('ocr/correct'), { method:'POST', body:fd })).json();
    if (r.error){ toast('矫正失败：'+r.error); return; }
    const wrap = _invOcrOverlay.querySelector('#invOcrLayerCanvasWrap');
    const imgData = r.imageBase64 || r.url;
    if (!imgData){ toast('矫正失败：未返回图片数据'); return; }
    const imgSrc = imgData.startsWith('data:') ? imgData : 'data:image/jpeg;base64,' + imgData;
    wrap.innerHTML = `<img src="${imgSrc}" style="max-width:100%;display:block;" id="invOcrLayerImg" crossorigin="anonymous" />`;
    wrap.style.display = 'block';
    _invOcrOverlay.querySelector('#invOcrLayerPreview').style.display = 'none';
    _invOcrOverlay.querySelector('#invOcrLayerTools').style.display = 'flex';
    _invOcrOverlay.querySelector('#invOcrLayerImg').onload = function(){
      const cv = document.createElement('canvas'); cv.id='invOcrLayerCanvas';
      cv.width = this.naturalWidth; cv.height = this.naturalHeight;
      const ctx = cv.getContext('2d'); ctx.drawImage(this, 0, 0);
      wrap.innerHTML = ''; wrap.appendChild(cv);
      cv.style.cursor = 'crosshair';
      // 统一使用 Pointer Events 支持鼠标+触摸
      cv.addEventListener('pointerdown', function(e){
        if(!_invOcrSelMode)return;
        e.preventDefault();
        _invOcrSelStart={x:e.offsetX,y:e.offsetY};
      }, {passive:false});
      cv.addEventListener('pointermove', function(e){
        if(!_invOcrSelMode||!_invOcrSelStart)return;
        e.preventDefault();
        const rect=cv.getBoundingClientRect();
        _invOcrSelRect={x:(e.clientX-rect.left)*(cv.width/rect.width),y:(e.clientY-rect.top)*(cv.height/rect.height)};
        invOcrLayerDrawSelRect();
      }, {passive:false});
      cv.addEventListener('pointerup', function(e){
        if(!_invOcrSelMode||!_invOcrSelStart||!_invOcrSelRect)return;
        const x=Math.min(_invOcrSelStart.x,_invOcrSelRect.x);
        const y=Math.min(_invOcrSelStart.y,_invOcrSelRect.y);
        const w=Math.abs(_invOcrSelRect.x-_invOcrSelStart.x);
        const h=Math.abs(_invOcrSelRect.y-_invOcrSelStart.y);
        if(w>10&&h>10){ _invOcrBoxes.push({x,y,w,h}); invOcrLayerRenderBoxes(); }
        _invOcrSelMode=false; _invOcrSelStart=null; _invOcrSelRect=null;
      }, {passive:false});
    };
    _invOcrOverlay.querySelector('#invOcrLayerImg').onerror = function(){ toast('图片加载失败'); };
  } catch(ex){ toast('矫正失败：'+ex.message); }
}

function invOcrLayerDrawSelRect(){
  var existing=_invOcrOverlay.querySelector('.inv-ocr-sel-rect');
  if(existing)existing.remove();
  if(!_invOcrSelStart||!_invOcrSelRect)return;
  const cv=_invOcrOverlay.querySelector('#invOcrLayerCanvas');
  if(!cv)return;
  const div=document.createElement('div'); div.className='inv-ocr-sel-rect';
  const sx=cv.offsetWidth/cv.width, sy=cv.offsetHeight/cv.height;
  div.style.cssText=`position:absolute;left:${Math.min(_invOcrSelStart.x,_invOcrSelRect.x)*sx}px;top:${Math.min(_invOcrSelStart.y,_invOcrSelRect.y)*sy}px;width:${Math.abs(_invOcrSelRect.x-_invOcrSelStart.x)*sx}px;height:${Math.abs(_invOcrSelRect.y-_invOcrSelStart.y)*sy}px;border:2px dashed #4f46e5;background:rgba(79,70,229,0.15);pointer-events:none;`;
  _invOcrOverlay.querySelector('#invOcrLayerCanvasWrap').style.position='relative';
  _invOcrOverlay.querySelector('#invOcrLayerCanvasWrap').appendChild(div);
}

function invOcrLayerRenderBoxes(){
  var existing=_invOcrOverlay.querySelectorAll('.inv-ocr-sel-box');
  existing.forEach(function(el){el.remove();});
  const cv=_invOcrOverlay.querySelector('#invOcrLayerCanvas');
  if(!cv)return;
  const wrap=_invOcrOverlay.querySelector('#invOcrLayerCanvasWrap');
  const sx=cv.offsetWidth/cv.width, sy=cv.offsetHeight/cv.height;
  _invOcrBoxes.forEach(function(b,i){
    const div=document.createElement('div'); div.className='inv-ocr-sel-box';
    div.style.cssText=`position:absolute;left:${b.x*sx}px;top:${b.y*sy}px;width:${b.w*sx}px;height:${b.h*sy}px;background:rgba(34,197,94,0.2);border:2px solid #16a34a;display:flex;align-items:center;justify-content:center;color:#16a34a;font-weight:700;font-size:12px;pointer-events:none;`;
    div.textContent='#'+(i+1);
    wrap.appendChild(div);
  });
}

async function invOcrLayerRun(){
  if(!_invOcrBoxes.length){ toast('请先框选识别区域'); return; }
  const cv=_invOcrOverlay.querySelector('#invOcrLayerCanvas');
  if(!cv){ toast('画布不存在'); return; }
  toast('识别中…');
  try {
    // 将 canvas 转 Blob 上传
    cv.toBlob(async function(blob){
      const fd=new FormData();
      fd.append('file', blob, 'photo.jpg');
      fd.append('boxes', JSON.stringify(_invOcrBoxes.map(function(b){return[b.x,b.y,b.w,b.h];})));
      try {
        const r=await(await fetch(invAPI('ocr/boxes'),{method:'POST',body:fd})).json();
        if(r.error){ toast('识别失败：'+r.error); return; }
        const results=r.results||[];
        const texts=results.map(function(t){ return t.text||''; }).join('\n');
        var resDiv=_invOcrOverlay.querySelector('#invOcrLayerRes');
        resDiv.style.display='block';
        resDiv.textContent=texts||'（未识别到文字）';
        _invOcrOverlay.querySelector('#invOcrLayerConfirm').style.display='block';
      } catch(ex){ toast('识别失败：'+ex.message); }
    }, 'image/jpeg', 0.9);
  } catch(ex){ toast('识别失败：'+ex.message); }
}

