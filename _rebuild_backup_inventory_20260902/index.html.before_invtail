    <div class="card">
      <div class="inv-field">
        <label>搜索（库号 / 编码 / 材料信息，支持模糊）</label>
        <input type="text" id="invSQ" placeholder="输入关键词…" autocomplete="off" />
      </div>
      <button class="btn" style="margin-top:10px;" id="invSrchBtn">🔍 查询</button>
    </div>
    <div id="invSrchResult" class="inv-list" style="padding:0 6px;"></div>`;
  _navPush('inv-add', '新增材料', invPageAdd, null);
  $('#invSrchBtn').onclick = invDoSearch;
  $('#invSQ').onkeydown = function(e){ if(e.key==='Enter') invDoSearch(); };
  invLoadHandlers();
}

async function invLoadHandlers(){
  try{ invHandlers = await (await fetch(invAPI('handlers'))).json(); } catch(e){ invHandlers = []; }
}

async function invDoSearch(){
  const q = ($('#invSQ').value||'').trim();
  const box = $('#invSrchResult');
  box.innerHTML = '<div class="empty"><span class="spinner"></span> 查询中…</div>';
  try {
    const list = await (await fetch(invAPI('search?q='+invEnc(q)))).json();
    if (!list || !list.length){ box.innerHTML='<div class="empty">未找到匹配记录</div>'; return; }
    box.innerHTML = list.map(function(m){
      return `<div class="inv-item" data-id="${m.id}">
        <div class="inv-item-text">
          <div class="inv-item-name">📦 ${invE(m.kuHao)} <span style="font-size:12px;color:var(--pri);">${invE(m.code)}</span></div>
          <div class="inv-item-meta">${invE(m.materialInfo)}</div>
          <span class="inv-qty-badge ${m.qty>0?'positive':'zero'}">库存：${m.qty}</span>
        </div>
      </div>`;}).join('');
    box.querySelectorAll('.inv-item').forEach(function(el){ el.onclick = function(){
      _navPush('inv-detail', '库存详情', invPageDetail.bind(null, parseInt(el.dataset.id)), null);
      invPageDetail(parseInt(el.dataset.id));
    }; });
  } catch(e){ box.innerHTML='<div class="empty">查询失败</div>'; }
}

async function invPageDetail(id){
  const root = $('#moduleRoot');
  root.style.justifyContent = 'flex-start'; root.style.paddingTop = '6px';
  root.innerHTML = `
    <div style="font-weight:700;font-size:15px;margin:2px 0 12px;">库存详情</div>
    <div id="invDetBody"><div class="empty"><span class="spinner"></span> 加载中…</div></div>`;
  // 详情页返回统一走顶部 #pageBack（←）
  try {
    const d = await (await fetch(invAPI('materials/'+id))).json();
    if (!d || !d.material){ $('#invDetBody').innerHTML='<div class="empty">材料不存在</div>'; return; }
    const m = d.material;
    const recs = d.records || [];
    $('#invDetBody').innerHTML = `
      <div class="card" style="margin:0 6px 10px;">
        <div style="font-size:15px;font-weight:700;margin-bottom:8px;">📦 ${invE(m.kuHao)}</div>
        <div style="font-size:13px;color:var(--sub);margin-bottom:6px;">编码：<b style="color:var(--pri)">${invE(m.code)}</b></div>
        <div style="font-size:13px;color:var(--sub);margin-bottom:6px;">材料：${invE(m.materialInfo)}</div>
        <div style="font-size:18px;font-weight:800;color:var(--ok);margin-top:8px;">当前库存：${m.qty}</div>
        <div style="font-size:12px;color:var(--sub);margin-top:4px;">创建：${invE(m.createdAt||'')}</div>
      </div>
      <div class="card" style="margin:0 6px 10px;">
        <div style="font-size:14px;font-weight:700;margin-bottom:10px;">📋 出入库记录</div>
        ${recs.length ? recs.map(function(r){return `<div style="display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line);font-size:13px;">
          <span style="flex:none;font-weight:700;color:${r.opType==='in'?'var(--ok)':'var(--bad)'};">${r.opType==='in'?'入库':'出库'}</span>
          <span style="color:var(--pri);font-weight:700;">${r.qty}</span>
          <span style="flex:1;color:var(--sub);">${invE(r.handler)}</span>
          <span style="flex:none;color:var(--sub);font-size:11px;">${invE(r.createdAt||'')}</span>
        </div>`;}).join('') : '<div class="empty">暂无记录</div>'}
      </div>
      <div class="card inv-card" style="margin:0 6px 10px;" id="invOpPanel">
        <div style="font-size:14px;font-weight:700;margin-bottom:8px;">🔄 出入库操作</div>
        <div class="inv-op-bar">
          <select id="invOpType"><option value="in">入库</option><option value="out">出库</option></select>
          <input type="number" id="invOpQty" placeholder="数量" min="1" style="flex:none;width:80px;" />
          <input type="text" id="invOpHandler" placeholder="经手人" style="flex:1;" />
        </div>
        <div id="invHandlerList" style="max-height:120px;overflow:auto;border:1px solid var(--line);border-radius:10px;margin-bottom:8px;"></div>
        <button class="btn" id="invOpSubmit">✅ 确认</button>
        <div id="invOpRes" style="font-size:13px;margin-top:6px;"></div>
      </div>`;
    invRenderHandlerList($('#invHandlerList'), $('#invOpHandler'));
    $('#invOpSubmit').onclick = function(){ invDoOp(id); };
  } catch(e){ $('#invDetBody').innerHTML='<div class="empty">加载失败</div>'; }
}

function invRenderHandlerList(container, inputEl){
  if (!invHandlers.length){
    container.innerHTML = '<div style="font-size:12px;color:var(--sub);padding:8px;">暂无历史记录</div>'; return;
  }
  container.innerHTML = invHandlers.map(function(h){return `<div class="dh-dd-item" data-name="${invE(h.name)}">${invE(h.name)}</div>`;}).join('');
  container.querySelectorAll('.dh-dd-item').forEach(function(el){ el.onclick = function(){ inputEl.value = el.dataset.name; container.innerHTML=''; }; });
}

async function invDoOp(id){
  const opType = $('#invOpType').value;
  const qty = parseInt($('#invOpQty').value||'0') || 0;
  const handler = ($('#invOpHandler').value||'').trim();
  if (!qty || !handler){ toast('数量和经手人不能为空'); return; }
  const res = await (await fetch(invAPI('materials/'+id+'/records'), {
    method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({opType, qty, handler})
  })).json();
  const box = $('#invOpRes');
  if (res.error){ box.innerHTML = '<div style="color:var(--bad);">'+invE(res.error)+'</div>'; }
  else { box.innerHTML = '<div style="color:var(--ok);">✅ '+(opType==='in'?'入库':'出库')+'成功，当前库存：'+res.currentQty+'</div>'; $('#invOpQty').value=''; }
  invLoadHandlers();
}



async function invOcrFileChange(e){
  const file = e.target.files[0]; if (!file) return;
  const url = URL.createObjectURL(file);
  $('#invOcrPreview').innerHTML = `<img src="${url}" style="max-width:100%;max-height:300px;border-radius:10px;border:1px solid var(--line);display:block;margin:0 auto;" />`;
  const fd = new FormData(); fd.append('file', file);
  toast('透视矫正中…');
  try {
    const r = await (await fetch(invAPI('ocr/correct'), { method:'POST', body:fd })).json();
    if (r.error){ toast('矫正失败：'+r.error); return; }
    const wrap = $('#invOcrCanvasWrap');
    wrap.innerHTML = `<img src="${r.url}?t=${Date.now()}" style="max-width:100%;display:block;" id="invCorrImg" crossorigin="anonymous" />`;
    wrap.style.display = 'block';
    $('#invCorrImg').onload = function(){
      const cv = document.createElement('canvas'); cv.id='invOcrCanvas';
      cv.width = this.naturalWidth; cv.height = this.naturalHeight;
      const ctx = cv.getContext('2d'); ctx.drawImage(this, 0, 0);
      wrap.innerHTML = ''; wrap.appendChild(cv);
      invBindCanvasEvents(cv);
    };
  } catch(e){ toast('矫正失败'); }
}

let invSelMode = false, invSelStart = null, invSelRect = null;
function invBindCanvasEvents(cv){
  const wrap = document.getElementById('invOcrCanvasWrap');
  cv.addEventListener('mousedown', function(e){ invSelStart = {x:e.offsetX, y:e.offsetY}; invSelMode = true; });
  document.addEventListener('mouseup', function(){
    if (invSelMode && invSelStart && invSelRect){
      const x = Math.min(invSelStart.x, invSelRect.x);
      const y = Math.min(invSelStart.y, invSelRect.y);
      const w = Math.abs(invSelRect.x - invSelStart.x);
      const h = Math.abs(invSelRect.y - invSelStart.y);
      if (w>10 && h>10){ invBoxes.push({x,y,w,h}); invRenderBoxes(); }
    }
    invSelMode = false; invSelStart = null;
  });
  document.addEventListener('mousemove', function(e){
    if (!invSelMode || !invSelStart) return;
    const rect = cv.getBoundingClientRect();
    const sx = (e.clientX - rect.left) * (cv.width / rect.width);
    const sy = (e.clientY - rect.top) * (cv.height / rect.height);
    invSelRect = {x:sx, y:sy};
    invDrawSelRect();
  });
  // canvas 框选相关事件由 mousedown/mousemove/mouseup 处理
}

function invDrawSelRect(){
  const existing = document.querySelector('.inv-sel-rect');
  if (existing) existing.remove();
  if (!invSelStart || !invSelRect) return;
  const cv = document.getElementById('invOcrCanvas');
  if (!cv) return;
  const rect = document.createElement('div'); rect.className='inv-sel-rect';
  const scaleX = cv.offsetWidth / cv.width;
  const scaleY = cv.offsetHeight / cv.height;
  rect.style.left = (Math.min(invSelStart.x,invSelRect.x)*scaleX)+'px';
  rect.style.top = (Math.min(invSelStart.y,invSelRect.y)*scaleY)+'px';
  rect.style.width = (Math.abs(invSelRect.x-invSelStart.x)*scaleX)+'px';
  rect.style.height = (Math.abs(invSelRect.y-invSelStart.y)*scaleY)+'px';
  document.getElementById('invOcrCanvasWrap').appendChild(rect);
}

function invRenderBoxes(){
  const existing = document.querySelectorAll('.inv-sel-box');
  existing.forEach(function(el){ el.remove(); });
  const cv = document.getElementById('invOcrCanvas');
  if (!cv) return;
  const wrap = document.getElementById('invOcrCanvasWrap');
  const scaleX = cv.offsetWidth / cv.width;
  const scaleY = cv.offsetHeight / cv.height;
  invBoxes.forEach(function(b, i){
    const div = document.createElement('div');
    div.className='inv-sel-rect inv-sel-box';
    div.style.left=(b.x*scaleX)+'px'; div.style.top=(b.y*scaleY)+'px';
    div.style.width=(b.w*scaleX)+'px'; div.style.height=(b.h*scaleY)+'px';
    div.style.background='rgba(34,197,94,.2)'; div.style.border='2px solid var(--ok)';
    div.textContent='#'+(i+1);
    div.style.display='flex'; div.style.alignItems='center'; div.style.justifyContent='center';
    div.style.color='var(--ok)'; div.style.fontWeight='700'; div.style.fontSize='12px';
    wrap.appendChild(div);
  });
}

async function invRunOcr(){
  if (!invBoxes.length){ toast('请先框选区域'); return; }
  const cv = document.getElementById('invOcrCanvas');
  if (!cv){ toast('画布不存在'); return; }
  const fd = new FormData();
  fd.append('file', cv.toDataURL('image/jpeg').split(',')[1]);
  fd.append('boxes', JSON.stringify(invBoxes.map(function(b){return[b.x,b.y,b.w,b.h];})));
  toast('识别中…');
  try {
    const r = await (await fetch(invAPI('ocr/boxes'), { method:'POST', body:fd })).json();
    if (r.error){ toast('识别失败：'+r.error); return; }
    invOcrResults = (r.results||[]).map(function(t){ return invParseOcrResult(t.text||''); });
    invRenderOcrResults();
    document.getElementById('invOcrSaveBar').style.display = 'block';
  } catch(e){ toast('识别失败'); }
}

function invParseOcrResult(text){
  const m10 = (text.match(/\d{10}/g)||[])[0] || '';
  const info = text.replace(/\d{10}/g,'').replace(/[_\-=~]+/g,' ').replace(/\s+/g,' ').trim();
  return { code: m10, materialInfo: info, qty: 0, kuHao: '' };
}

function invRenderOcrResults(){
  const resBox = document.getElementById('invOcrRes');
  if (!invOcrResults.length){ resBox.innerHTML='<div class="empty">未识别到有效内容</div>'; return; }
  resBox.innerHTML = '<div style="font-size:13px;font-weight:700;margin-bottom:8px;">识别结果：</div>' +
    invOcrResults.map(function(r,i){
      return `<div class="inv-ocr-item ok">
        <div style="font-size:12px;color:var(--sub);">#${i+1}</div>
        <div class="inv-field"><label>库号</label><input type="text" id="invR_KuHao_${i}" value="${invE(r.kuHao)}" placeholder="库号" /></div>
        <div class="inv-field"><label>编码</label><input type="text" id="invR_Code_${i}" value="${invE(r.code)}" placeholder="10位数字" /></div>
        <div class="inv-field"><label>材料信息</label><textarea id="invR_Info_${i}" placeholder="材料描述" style="width:100%;padding:8px;border-radius:10px;border:1px solid var(--line);font-size:13px;resize:vertical;">${invE(r.materialInfo)}</textarea></div>
        <div style="display:flex;gap:6px;align-items:center;margin-top:4px;">
          <input type="number" id="invR_Qty_${i}" value="${r.qty||0}" min="0" placeholder="数量" style="width:80px;padding:7px;border-radius:10px;border:1px solid var(--line);font-size:13px;" />
          <button class="btn sm" style="margin-left:auto;background:var(--ok);color:#fff;" onclick="invSaveOne(${i})">💾 保存</button>
        </div>
      </div>`;}).join('');
}

async function invSaveOne(idx){
  const r = invOcrResults[idx];
  if (!r) return;
  const body = {
    kuHao: (document.getElementById('invR_KuHao_'+idx).value||'').trim() || 'DEFAULT',
    code: (document.getElementById('invR_Code_'+idx).value||'').trim(),
    materialInfo: (document.getElementById('invR_Info_'+idx).value||'').trim(),
    qty: parseInt(document.getElementById('invR_Qty_'+idx).value||'0') || 0
  };
  if (!body.code){ toast('编码不能为空'); return; }
  if (!/^\d{10}$/.test(body.code)){ toast('编码必须为10位数字'); return; }
  const res = await (await fetch(invAPI('materials'), { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) })).json();
  toast(res.error ? '保存失败' : '✅ 保存成功');
}

async function invSaveBatch(){
  const items = invOcrResults.map(function(r,i){
    return {
      kuHao: (document.getElementById('invR_KuHao_'+i).value||'').trim() || 'DEFAULT',
      code: (document.getElementById('invR_Code_'+i).value||'').trim(),
      materialInfo: (document.getElementById('invR_Info_'+i).value||'').trim(),
      qty: parseInt(document.getElementById('invR_Qty_'+i).value||'0') || 0
    };
  }).filter(function(it){ return it.code && /^\d{10}$/.test(it.code); });
  if (!items.length){ toast('没有可保存的有效记录'); return; }
  const res = await (await fetch(invAPI('materials/batch'), { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({items}) })).json();
  toast(`✅ 保存完成：${res.okCount||0}/${res.total||0} 条成功`);
  invOcrResults = [];
  document.getElementById('invOcrRes').innerHTML = '';
  document.getElementById('invOcrSaveBar').style.display = 'none';
}

