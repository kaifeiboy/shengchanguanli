      <div class="ic" style="background:${c.bg};box-shadow:0 6px 20px ${c.shadow};">${esc(m.icon||'📦')}</div>
      <div class="lb">${esc(name)}</div>
      <div class="sub">${esc(subs[m.key]||'')}</div>
    </div>`;
  });
  html += `</div></div>`;
  root.innerHTML = html;
}

// ---- 进入模块 ----
function openModule(key){
  const mod = modulesCache.find(m=>m.key===key);
  const name = mod ? mod.name.replace('比对','').replace('对比','') : key;
  // 添加到导航栈，显示返回按钮
  _navPush(key, name, function(){
    $('#pageBack').style.display = 'inline';
    $('#pageBack').onclick = _navBack;
    if (MODULE_RENDERERS[key]) MODULE_RENDERERS[key]();
  }, null);
  // 显示返回按钮
  $('#pageBack').style.display = 'inline';
  $('#pageBack').onclick = _navBack;
  if (MODULE_RENDERERS[key]){
    MODULE_RENDERERS[key]();
  }
}

