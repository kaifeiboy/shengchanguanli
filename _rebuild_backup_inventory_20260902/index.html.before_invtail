}

// ---- 统一 fetch 封装：处理 HTTP 状态码 + 代理错误 ----
async function unbindFetch(url, bodyObj){
  let resp;
  try{
    resp = await fetch(url, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(bodyObj)
    });
  }catch(e){
    throw { type:'network', icon:'📡', cls:'e-network', title:'网络不通',
      detail:'无法连接到服务器，请检查 Wi-Fi 或网络连接。(' + (e.message||e) + ')' };
  }
  const raw = await resp.text();
  let body = null;
  try{ body = JSON.parse(raw); }catch(_){ /* 非 JSON 响应 */ }
  if (!resp.ok) throw unbindClassifyError(resp.status, body);
  // resp.ok=true 但代理可能返回 {code:-1, msg:"连接目标系统失败：..."}
  if (body && body.code !== undefined && body.code !== 0 && body.code !== 200){
    const msg = body.msg || body.message || '未知错误';
    if (msg.includes('超时') || msg.includes('timeout'))
      throw { type:'timeout', icon:'⏱️', cls:'e-timeout', title:'请求超时', detail: msg };
    if (msg.includes('连接目标系统失败') || msg.includes('ECONNREFUSED') || msg.includes('ENOTFOUND'))
      throw { type:'target', icon:'📡', cls:'e-target', title:'目标系统不可达', detail: msg };
    throw { type:'server', icon:'⚠️', cls:'e-server', title:'操作失败', detail: msg };
  }
  return body;
}

