      }
    }
    dhAnnoState.drawing = false;
    dhAnnoState.cur = null;
    dhAnnoDraw();
  }
}
function dhAnnoApplyTransform(){
  const cv = document.getElementById('dhAnnoCanvas');
  cv.style.transformOrigin = '0 0';
  cv.style.transform = 'translate(' + dhAnnoState.panX + 'px,' + dhAnnoState.panY + 'px) scale(' + dhAnnoState.zoom + ')';
  const lbl = document.getElementById('dhAnnoZoomLabel');
  if (lbl) lbl.textContent = Math.round(dhAnnoState.zoom * 100) + '%';
}
function dhAnnoZoomAt(cx, cy, factor){
  if (!dhAnnoState) return;
  const cv = document.getElementById('dhAnnoCanvas');
  const rect = cv.getBoundingClientRect();
  const z0 = dhAnnoState.zoom;
  const maxZoom = Math.max(1, Math.min(12, 1 / (dhAnnoState.scale || 1)));
  const z = Math.max(1, Math.min(maxZoom, z0 * factor));
  const ux = (cx - rect.left) / z0;
  const uy = (cy - rect.top) / z0;
  dhAnnoState.zoom = z;
  dhAnnoState.panX = (cx - rect.left) - ux * z + dhAnnoState.panX;
  dhAnnoState.panY = (cy - rect.top) - uy * z + dhAnnoState.panY;
  dhAnnoApplyTransform();
}
function dhAnnoWheel(e){
  if (!dhAnnoState) return;
  e.preventDefault();
  dhAnnoZoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.15 : 1 / 1.15);
}
function dhAnnoResetView(){
  if (!dhAnnoState) return;
  dhAnnoState.zoom = 1; dhAnnoState.panX = 0; dhAnnoState.panY = 0;
  dhAnnoApplyTransform();
}
// 检测点是否在某个标注的调整手柄上，返回手柄类型，未命中返回null
function dhAnnoHitTestHandle(p, idx){
  const s = dhAnnoState.anno[idx];
  if (!s || s.type === 'free' || s.type === 'text') return null; // 自由绘制和文字不支持调整大小
  const handleSize = 12;
  if (s.type === 'rect' || s.type === 'ellipse'){
    const rx = s.w >= 0 ? s.x : s.x + s.w, ry = s.h >= 0 ? s.y : s.y + s.h;
    const rw = Math.abs(s.w), rh = Math.abs(s.h);
    const handles = [
      { x: rx, y: ry, type: 'tl' }, { x: rx + rw, y: ry, type: 'tr' },
      { x: rx, y: ry + rh, type: 'bl' }, { x: rx + rw, y: ry + rh, type: 'br' }
    ];
    for (const h of handles){
      if (Math.abs(p.x - h.x) < handleSize && Math.abs(p.y - h.y) < handleSize) return h.type;
    }
  } else if (s.type === 'arrow'){
    if (Math.abs(p.x - s.x1) < handleSize && Math.abs(p.y - s.y1) < handleSize) return 'start';
    if (Math.abs(p.x - s.x2) < handleSize && Math.abs(p.y - s.y2) < handleSize) return 'end';
  }
  return null;
}
// 检测点是否在某个标注上，返回索引，未命中返回-1
function dhAnnoHitTest(p){
  const hitPadding = 10;
  for (var i = dhAnnoState.anno.length - 1; i >= 0; i--){
    const s = dhAnnoState.anno[i];
    if (s.type === 'rect' || s.type === 'ellipse'){
      var rx = s.w >= 0 ? s.x : s.x + s.w, ry = s.h >= 0 ? s.y : s.y + s.h;
      var rw = Math.abs(s.w), rh = Math.abs(s.h);
      if (p.x >= rx - hitPadding && p.x <= rx + rw + hitPadding && p.y >= ry - hitPadding && p.y <= ry + rh + hitPadding) return i;
    } else if (s.type === 'arrow'){
      var d = Math.max(Math.abs(p.x - s.x1), Math.abs(p.y - s.y1));
      var d2 = Math.max(Math.abs(p.x - s.x2), Math.abs(p.y - s.y2));
      if (d < hitPadding + s.size || d2 < hitPadding + s.size) return i;
    } else if (s.type === 'free'){
      for (var j = 0; j < s.points.length; j++){
        if (Math.abs(p.x - s.points[j][0]) < hitPadding + s.size && Math.abs(p.y - s.points[j][1]) < hitPadding + s.size) return i;
      }
    } else if (s.type === 'text'){
      if (p.x >= s.x - hitPadding && p.x <= s.x + 80 && p.y >= s.y - s.font - hitPadding && p.y <= s.y + hitPadding) return i;
    }
  }
  return -1;
}
function dhAnnoPush(shape){
  dhAnnoState.undo.push(dhAnnoState.anno.slice());
  dhAnnoState.redo = [];
  dhAnnoState.anno.push(shape);
}
function dhAnnoUndo(){
  if (!dhAnnoState || !dhAnnoState.undo.length) return;
  dhAnnoState.redo.push(dhAnnoState.anno.slice());
  dhAnnoState.anno = dhAnnoState.undo.pop();
  dhAnnoDraw();
}
function dhAnnoRedo(){
  if (!dhAnnoState || !dhAnnoState.redo.length) return;
  dhAnnoState.undo.push(dhAnnoState.anno.slice());
  dhAnnoState.anno = dhAnnoState.redo.pop();
  dhAnnoDraw();
}
function dhAnnoClear(){
  if (!dhAnnoState) return;
  if (!dhAnnoState.anno.length) return;
  dhAnnoState.undo.push(dhAnnoState.anno.slice());
  dhAnnoState.redo = [];
  dhAnnoState.anno = [];
  dhAnnoDraw();
}
function dhAnnoDraw(){
  if (!dhAnnoState) return;
  const st = dhAnnoState, c = document.getElementById('dhAnnoCanvas'), ctx = c.getContext('2d');
  ctx.clearRect(0, 0, c.width, c.height);
  if (st.img && st.img.complete) ctx.drawImage(st.img, 0, 0, c.width, c.height);
  const drawShape = (s) => {
    ctx.strokeStyle = s.color; ctx.fillStyle = s.color; ctx.lineWidth = Math.max(1, s.size); ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    if (s.type === 'rect') ctx.strokeRect(s.x, s.y, s.w, s.h);
    else if (s.type === 'ellipse'){ ctx.beginPath(); ctx.ellipse(s.x + s.w / 2, s.y + s.h / 2, Math.abs(s.w) / 2, Math.abs(s.h) / 2, 0, 0, Math.PI * 2); ctx.stroke(); }
    else if (s.type === 'arrow') drawArrow(ctx, s.x1, s.y1, s.x2, s.y2, s.color, Math.max(1, s.size));
    else if (s.type === 'free'){ ctx.beginPath(); s.points.forEach((p, i) => i ? ctx.lineTo(p[0], p[1]) : ctx.moveTo(p[0], p[1])); ctx.stroke(); }
    else if (s.type === 'text'){ const fs = (s.font || Math.min(Math.max(24, st.natW * 0.04 * (s.size / 4)), st.natW * 0.1)); ctx.font = fs + 'px sans-serif'; ctx.textBaseline = 'top'; ctx.fillText(s.text, s.x, s.y); }
  };
  st.anno.forEach(drawShape);
  if (st.cur) drawShape(st.cur);
  // 绘制选中标注的调整手柄
  if (st.editingIdx !== undefined && st.anno[st.editingIdx]){
    const s = st.anno[st.editingIdx];
    const handleSize = 12;
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 2;
    ctx.fillStyle = '#2196F3';
    if (s.type === 'rect' || s.type === 'ellipse'){
      const rx = s.w >= 0 ? s.x : s.x + s.w, ry = s.h >= 0 ? s.y : s.y + s.h;
      const rw = Math.abs(s.w), rh = Math.abs(s.h);
      const handles = [
        { x: rx, y: ry }, { x: rx + rw, y: ry },
        { x: rx, y: ry + rh }, { x: rx + rw, y: ry + rh }
      ];
      handles.forEach(h => {
        ctx.beginPath();
        ctx.arc(h.x, h.y, handleSize / 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      });
    } else if (s.type === 'arrow'){
      [{ x: s.x1, y: s.y1 }, { x: s.x2, y: s.y2 }].forEach(h => {
        ctx.beginPath();
        ctx.arc(h.x, h.y, handleSize / 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      });
    }
  }
}
function dhAnnoSave(){
  const st = dhAnnoState; if (!st) return;
  const it = dhAddFiles[st.idx];
  const cv = document.createElement('canvas'); cv.width = st.natW; cv.height = st.natH;
  const x = cv.getContext('2d');
