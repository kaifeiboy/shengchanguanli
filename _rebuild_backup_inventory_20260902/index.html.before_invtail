// 图片 URL：单 Sheet 汇总表，只需 row（file/sheet 服务端忽略）
function dhImgUrl(row, i, thumb){
  return dhAPI('image?row=' + row + '&i=' + (i||0) + (thumb ? '&thumb=true' : '') + '&v=' + dhPageNonce);
}

function dhRenderQueryResult(box, r){
  const total = r.total || 0;
  const rows = r.rows || [];
  if(total === 0){ box.innerHTML = '<div class="empty">未找到匹配记录</div>'; dhSelected.clear(); return; }
  // 批量删除工具栏（始终渲染，0 条也可点全选清理）
  let html = `<div class="dh-batch-bar">
    <label class="dh-sel-all"><input type="checkbox" id="dhSelAll"/> <span>全选</span></label>
    <button class="btn sm ghost" id="dhSelInv">反选</button>
    <button class="btn sm ghost" id="dhSelClr">清空</button>
    <span id="dhSelCount" class="dh-sel-count">已选 0 条</span>
    <button class="btn sm" id="dhBatchDel" disabled style="background:var(--bad);">🗑 批量删除</button>
  </div>
  <div class="meta-line" style="margin:4px 2px 10px;">共命中 <b>${total}</b> 条记录</div>`;
  // 后端返回平铺行 → 前端按日期月份分组展示
  const groups = {};
  rows.forEach(row => { const m = (row.date||'').slice(0,7) || '未知'; (groups[m] = groups[m] || []).push(row); });
  let allKeys = [];
  Object.keys(groups).sort().reverse().forEach(m => {
    const g = groups[m];
    html += `<div class="card" style="padding:14px;">
      <h3 style="font-size:15px;margin-bottom:10px;">📅 ${esc(m)} <span class="tag ok">${g.length} 条</span></h3>`;
    g.forEach(row => {
      const key = String(row.row);   // 单 Sheet 汇总表：key = 数据行索引
      allKeys.push(key);
      html += `<div class="dh-row" data-key="${key}">
        <input type="checkbox" class="dh-cb" data-key="${key}" aria-label="选择此行"/>
        <div class="dh-row-text">
          <div class="meta-line"><b>${esc(row.date)}</b> · ${esc(row.line)} · <b>${esc(row.model)}</b></div>
          <div class="meta-line">发生工程：${esc(row.stage||'-')} ｜ 数量：${esc(row.qty||'-')} ｜ 处理：${esc(row.handle||'-')}</div>
          <div class="meta-line" style="color:var(--txt);">${esc(row.reason||'')}</div>
        </div>
        <div class="dh-row-img">
          ${row.hasImage
            ? `<span class="dh-img-wrap dh-loading"><img class="dh-thumb" loading="lazy" decoding="async" data-row="${row.row}" data-i="0" src="${dhImgUrl(row.row, 0, true)}" alt="不良图"/></span>`
            : '<span class="tag part">无图</span>'}
        </div>
      </div>`;
    });
    html += `</div>`;
  });
  box.innerHTML = html;

  // 图片：加载中 spinner → 成功显示 / 失败占位可重试；点击放大
  box.querySelectorAll('.dh-img-wrap').forEach(wrap => {
    const im = wrap.querySelector('img.dh-thumb');
    if (!im) return;
    im.addEventListener('load', () => wrap.classList.remove('dh-loading'));
    im.addEventListener('error', () => {
      wrap.classList.remove('dh-loading');
      wrap.classList.add('dh-error');
      if (!wrap.querySelector('.dh-img-err-txt')){
        const t = document.createElement('span');
        t.className = 'dh-img-err-txt';
        t.textContent = '⚠️ 图片加载失败，点此重试';
        wrap.appendChild(t);
        t.onclick = (e) => { e.stopPropagation(); dhImgRetry(wrap, im); };
        // 自动重试一次（带缓存破坏符），覆盖瞬时网络抖动
        if (!wrap.dataset.retried){
          wrap.dataset.retried = '1';
          setTimeout(() => { if (wrap.classList.contains('dh-error')) dhImgRetry(wrap, im); }, 1500);
        }
      }
    });
    im.onclick = () => dhViewImage(im.dataset.row, im.dataset.i);
  });
  // 复选框：更新选中集合 + 行高亮 + 工具栏计数
  box.querySelectorAll('.dh-cb').forEach(cb => {
    cb.addEventListener('change', () => {
      const k = cb.dataset.key;
      if (cb.checked) dhSelected.add(k); else dhSelected.delete(k);
      const row = cb.closest('.dh-row');
      if (row) row.classList.toggle('dh-row-sel', cb.checked);
      dhUpdateBatchBar(box, allKeys);
    });
  });
  // 工具栏事件
  const allCb = $('#dhSelAll', box); if (allCb) allCb.onchange = (e) => dhSetAllChecked(box, allKeys, !!e.target.checked);
  const invBtn = $('#dhSelInv', box); if (invBtn) invBtn.onclick = () => dhSetAllChecked(box, allKeys, null);
  const clrBtn = $('#dhSelClr', box); if (clrBtn) clrBtn.onclick = () => dhSetAllChecked(box, allKeys, false);
  const batchBtn = $('#dhBatchDel', box); if (batchBtn) batchBtn.onclick = dhBatchDelete;
  // 新一次查询：清掉与新结果不重合的旧选择（保持新结果里仍勾选的）
  for (const k of Array.from(dhSelected)) if (!allKeys.includes(k)) dhSelected.delete(k);
  // 恢复勾选状态 + 高亮
  box.querySelectorAll('.dh-cb').forEach(cb => {
    if (dhSelected.has(cb.dataset.key)) { cb.checked = true; cb.closest('.dh-row').classList.add('dh-row-sel'); }
  });
  dhUpdateBatchBar(box, allKeys);
}

function dhSetAllChecked(box, allKeys, checked){
  box.querySelectorAll('.dh-cb').forEach(cb => {
    if (allKeys.includes(cb.dataset.key)){
      const want = (checked === null) ? !cb.checked : checked;
      if (cb.checked !== want){ cb.checked = want; cb.dispatchEvent(new Event('change')); }
    }
  });
}

function dhUpdateBatchBar(box, allKeys){
  const inResult = Array.from(dhSelected).filter(k => allKeys.includes(k));
  $('#dhSelCount', box).textContent = '已选 ' + inResult.length + ' 条';
  const total = allKeys.length;
  $('#dhBatchDel', box).disabled = inResult.length === 0;
  const allCb = $('#dhSelAll', box);
  if (allCb) allCb.checked = total > 0 && inResult.length === total;
  else if (allCb) allCb.checked = false;
}

async function dhBatchDelete(){
  // 单 Sheet 汇总表：key = 数据行索引
  const items = Array.from(dhSelected).map(k => ({ row: parseInt(k, 10) }));
  if (items.length === 0) return;
  const preview = items.slice(0, 3).map(i => '第' + (i.row + 1) + '行').join('\n');
  const more = items.length > 3 ? '\n... 等共 ' + items.length + ' 条' : '';
  if (!confirm('确定批量删除这 ' + items.length + ' 条不良记录？\n\n' + preview + more + '\n\n每条删除前会自动备份 (.bak)。')) return;
  let ok = 0, bad = 0, firstErr = '';
  toast('开始批量删除 ' + items.length + ' 条…');
  for (const it of items){
    try{
      const r = await (await fetch(dhAPI('delete'), {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify(it)
      })).json();
      if (r.ok) ok++; else { bad++; if (!firstErr) firstErr = r.error || '未知'; }
    }catch(e){ bad++; if (!firstErr) firstErr = e.message || String(e); }
  }
  dhSelected.clear();
  toast('批量删除完成：成功 ' + ok + (bad ? ' / 失败 ' + bad + (firstErr ? '（' + firstErr + '）' : '') : ''));
  if (dhLastQuery) dhDoQuery();
}

function dhImgRetry(wrap, im){
  wrap.classList.add('dh-loading');
  wrap.classList.remove('dh-error');
  const t = wrap.querySelector('.dh-img-err-txt');
  if (t) t.remove();
  // 追加时间戳绕过浏览器缓存，强制重新加载
  im.src = dhImgUrl(im.dataset.row, im.dataset.i, true) + '&t=' + Date.now();
}

function dhViewImage(row, i){
  const src = dhImgUrl(row, i, false);
  const ov = document.createElement('div');
  ov.style.cssText = 'position:fixed;inset:0;background:rgba(10,15,25,.88);z-index:200;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;';
  const spin = document.createElement('div');
  spin.className = 'dh-img-spin';
  const img = document.createElement('img');
  img.style.cssText = 'max-width:94vw;max-height:84vh;border-radius:10px;object-fit:contain;background:#fff;';
  img.alt = '不良图';
  // 调试信息：让用户可现场核对"图片对应行"（如仍有错配可一键定位）
  const hint = document.createElement('div');
  hint.style.cssText = 'color:#cbd5e1;font-size:11.5px;text-align:center;line-height:1.6;';
  hint.innerHTML = '服务端 row=<b style="color:#fff;">' + row + '</b> → xlsx 1-based row=<b style="color:#fff;">' + (row + 2) + '</b><br/>点击任意处关闭';
  ov.appendChild(spin);
  ov.appendChild(img);
  ov.appendChild(hint);
  let loaded = false;
  img.onload = () => { loaded = true; spin.remove(); };
  img.onerror = () => {
    spin.remove();
    img.remove();
    const err = document.createElement('div');
    err.style.cssText = 'color:#fca5a5;font-size:14px;font-weight:600;padding:14px 18px;border:1px dashed rgba(252,165,165,.5);border-radius:10px;background:rgba(30,20,20,.5);cursor:pointer;';
    err.textContent = '⚠️ 图片加载失败，点此重试';
    err.onclick = () => { err.remove(); ov.appendChild(spin); const n = new Image(); n.src = src + '&t=' + Date.now(); n.onload = () => { loaded = true; spin.remove(); ov.insertBefore(n, hint); n.style.cssText = img.style.cssText; }; n.onerror = () => { spin.remove(); err.textContent = '加载失败，请检查网络后重试'; ov.appendChild(err); }; };
    ov.appendChild(err);
  };
  img.src = src;
  ov.onclick = () => ov.remove();
  document.body.appendChild(ov);
}

