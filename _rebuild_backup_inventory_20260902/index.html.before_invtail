// 图像预处理：灰度
function _makeGrayCanvas(srcCanvas){
  const w=srcCanvas.width, h=srcCanvas.height;
  const dst=document.createElement('canvas'); dst.width=w; dst.height=h;
  const srcCtx=srcCanvas.getContext('2d');
  const dstCtx=dst.getContext('2d');
  const imgData=srcCtx.getImageData(0,0,w,h);
  const d=imgData.data;
  for(let i=0;i<d.length;i+=4){
    const g=Math.round(0.299*d[i]+0.587*d[i+1]+0.114*d[i+2]);
    d[i]=d[i+1]=d[i+2]=g;
  }
  dstCtx.putImageData(imgData,0,0);
  return dst;
}
// 图像预处理：二值化
function _makeBinaryCanvas(srcCanvas, threshold){
  const w=srcCanvas.width, h=srcCanvas.height;
  const dst=document.createElement('canvas'); dst.width=w; dst.height=h;
  const srcCtx=srcCanvas.getContext('2d');
  const dstCtx=dst.getContext('2d');
  const imgData=srcCtx.getImageData(0,0,w,h);
  const d=imgData.data;
  for(let i=0;i<d.length;i+=4){
    const g=Math.round(0.299*d[i]+0.587*d[i+1]+0.114*d[i+2]);
    const v=g<threshold?0:255;
    d[i]=d[i+1]=d[i+2]=v; d[i+3]=255;
  }
  dstCtx.putImageData(imgData,0,0);
  return dst;
}
// 图像预处理：等比放大
function _scaleCanvas(srcCanvas, factor){
  const w=Math.round(srcCanvas.width*factor), h=Math.round(srcCanvas.height*factor);
  const dst=document.createElement('canvas'); dst.width=w; dst.height=h;
  const ctx=dst.getContext('2d');
  ctx.imageSmoothingEnabled=true;
  ctx.imageSmoothingQuality='high';
  ctx.drawImage(srcCanvas,0,0,w,h);
  return dst;
}
// 图像预处理：旋转/翻转。deg=0/90/180/270；flip='h'|'v'|'hv'（水平/垂直/180度）。
// jsQR / zxing-js 默认不试 4 方向（zxing-cpp 服务端支持），倒置/侧向 QR 必须靠旋转变体解出。
// canvas 旋转代价：~1ms（1280x720 实测），相比 3500ms 的 ZXing 单变体超时可忽略。
function _flipCanvas(srcCanvas, mode){
  const w=srcCanvas.width, h=srcCanvas.height;
  const dst=document.createElement('canvas'); dst.width=w; dst.height=h;
  const ctx=dst.getContext('2d');
  if(mode==='h'){ ctx.translate(w,0); ctx.scale(-1,1); ctx.drawImage(srcCanvas,0,0); }
  else if(mode==='v'){ ctx.translate(0,h); ctx.scale(1,-1); ctx.drawImage(srcCanvas,0,0); }
  else { ctx.translate(w,h); ctx.scale(-1,-1); ctx.drawImage(srcCanvas,0,0); }
  return dst;
}
// 图像预处理：CLAHE 局部直方图均衡（修复 PCB 浅灰/反光/低对比度二维码无法识别）
// 等价于 cv2.createCLAHE(clipLimit, tileGridSize=(N,N))
// 性能：1280x720 桌面 V8 约 57ms，3x 降采样到 426x240 后约 7ms
// 为控制单帧成本，大于 960 长边的图像先降采样再 CLAHE（QR 解码对 426+ 像素足够鲁棒）
function _claheCanvas(srcCanvas, clipLimit, tileGrid){
  clipLimit = (typeof clipLimit==='number' && clipLimit>0) ? clipLimit : 2.0;
  const tg = (typeof tileGrid==='number' && tileGrid>=2) ? tileGrid : 8;
  let w=srcCanvas.width, h=srcCanvas.height;
  let workCanvas=srcCanvas;
  // 大图先降采样，控制单帧成本（CLAHE 是 O(npix)，1280x720 桌面约 57ms，移动端约 150-250ms）
  const LONG_EDGE_MAX=960;
  const longEdge=Math.max(w,h);
  if(longEdge>LONG_EDGE_MAX){
    const sc=LONG_EDGE_MAX/longEdge;
    workCanvas=_scaleCanvas(srcCanvas, sc); // _scaleCanvas 在同文件上面定义
    w=workCanvas.width; h=workCanvas.height;
  }
  const srcCtx=workCanvas.getContext('2d');
  const sd=srcCtx.getImageData(0,0,w,h).data;
  const npix = w*h;
  // 灰度图（定点化避免浮点运算）
  const gray=new Uint8Array(npix);
  for(let i=0,j=0;j<npix;i+=4,j++){
    // ITU-R BT.601 luma: 0.299R+0.587G+0.114B ≈ (77R+150G+29B)/256
    gray[j] = (sd[i]*77 + sd[i+1]*150 + sd[i+2]*29) >> 8;
  }
  const tx=Math.max(2, Math.floor(tg));
  const ty=Math.max(2, Math.floor(tg));
  const NUM=256;
  const luts=new Uint8Array(tx*ty*NUM);
  // tile 边界预计算
  const yBounds=new Int32Array(ty+1);
  const xBounds=new Int32Array(tx+1);
  for(let i=0;i<=ty;i++) yBounds[i] = Math.floor(i*h/ty);
  for(let i=0;i<=tx;i++) xBounds[i] = Math.floor(i*w/tx);
  // 每 tile 直方图 + CDF
  for(let tyi=0; tyi<ty; tyi++){
    const y0=yBounds[tyi], y1=yBounds[tyi+1];
    for(let txi=0; txi<tx; txi++){
      const x0=xBounds[txi], x1=xBounds[txi+1];
      const tnpix=(x1-x0)*(y1-y0);
      const hist=new Uint32Array(NUM);
      for(let y=y0;y<y1;y++){
        const off=y*w;
        for(let x=x0;x<x1;x++) hist[gray[off+x]]++;
      }
      let clipVal=(clipLimit*tnpix/NUM)|0;
      if(clipVal<1) clipVal=1;
      let excess=0;
      for(let i=0;i<NUM;i++){
        const h=hist[i];
        if(h>clipVal){ excess += (h-clipVal); hist[i]=clipVal; }
      }
      const perBin=(excess/NUM)|0;
      const rem=excess - perBin*NUM;
      for(let i=0;i<NUM;i++) hist[i] += perBin + (i<rem?1:0);
      let cum=0;
      const lutBase=(tyi*tx+txi)*NUM;
      for(let i=0;i<NUM;i++){
        cum += hist[i];
        luts[lutBase+i] = ((cum*255)/tnpix)|0;
      }
    }
  }
  // 输出（像素级双线性插值）
  const dst=document.createElement('canvas'); dst.width=w; dst.height=h;
  const dstCtx=dst.getContext('2d');
  const dstImg=dstCtx.createImageData(w,h);
  const dd=dstImg.data;
  const tileWp=w/tx, tileHp=h/ty;
  for(let y=0;y<h;y++){
    const yw=y*w;
    const gy=((y+0.5)/tileHp) - 0.5;
    let tyi=gy|0;
    if(tyi<0) tyi=0;
    else if(tyi>=ty-1) tyi=ty-2;
    if(tyi<0) tyi=0; if(tyi>ty-2) tyi=ty-2;
    let fy=gy-tyi; if(fy<0) fy=0; else if(fy>1) fy=1;
    const baseY=tyi*tx, baseY1=(tyi+1)*tx;
    for(let x=0;x<w;x++){
      const gx=((x+0.5)/tileWp) - 0.5;
      let txi=gx|0;
      if(txi<0) txi=0;
      else if(txi>=tx-1) txi=tx-2;
      if(txi<0) txi=0; if(txi>tx-2) txi=tx-2;
      let fx=gx-txi; if(fx<0) fx=0; else if(fx>1) fx=1;
      const v=gray[yw+x];
      const a=luts[(baseY +txi)*NUM+v]*(1-fx)*(1-fy)
             + luts[(baseY +txi+1)*NUM+v]*fx*(1-fy)
             + luts[(baseY1+txi)*NUM+v]*(1-fx)*fy
             + luts[(baseY1+txi+1)*NUM+v]*fx*fy;
      const idx=(yw+x)*4;
      dd[idx]=a; dd[idx+1]=a; dd[idx+2]=a; dd[idx+3]=255;
    }
  }
  dstCtx.putImageData(dstImg,0,0);
  return dst;
}
// 图像预处理：自动对比度拉伸（把灰度范围拉满 0-255，提升浅灰色二维码对比度）
function _autoContrastCanvas(srcCanvas){
  const w=srcCanvas.width, h=srcCanvas.height;
  const dst=document.createElement('canvas'); dst.width=w; dst.height=h;
  const srcCtx=srcCanvas.getContext('2d');
  const dstCtx=dst.getContext('2d');
  const imgData=srcCtx.getImageData(0,0,w,h);
  const d=imgData.data;
  let min=255, max=0;
  for(let i=0;i<d.length;i+=4){
    const g=Math.round(0.299*d[i]+0.587*d[i+1]+0.114*d[i+2]);
    if(g<min) min=g; if(g>max) max=g;
  }
  if(max<=min) max=min+1;
  const range=max-min;
  for(let i=0;i<d.length;i+=4){
    const g=Math.round(0.299*d[i]+0.587*d[i+1]+0.114*d[i+2]);
    const v=Math.round((g-min)*255/range);
    d[i]=d[i+1]=d[i+2]=v; d[i+3]=255;
  }
  dstCtx.putImageData(imgData,0,0);
  return dst;
}
// 图像预处理：中心裁剪（ratio: 0-1，用户常把目标放画面中央）
function _centerCropCanvas(srcCanvas, ratio){
  const w=Math.max(1, Math.round(srcCanvas.width*ratio));
  const h=Math.max(1, Math.round(srcCanvas.height*ratio));
  const x=Math.round((srcCanvas.width-w)/2);
  const y=Math.round((srcCanvas.height-h)/2);
  const dst=document.createElement('canvas'); dst.width=w; dst.height=h;
  dst.getContext('2d').drawImage(srcCanvas, x, y, w, h, 0, 0, w, h);
  return dst;
}
// 图像预处理：自适应阈值（局部均值，适合光照不均）
function _adaptiveThresholdCanvas(srcCanvas, blockSize, C){
  const w=srcCanvas.width, h=srcCanvas.height;
  const dst=document.createElement('canvas'); dst.width=w; dst.height=h;
  const srcCtx=srcCanvas.getContext('2d');
  const dstCtx=dst.getContext('2d');
  const imgData=srcCtx.getImageData(0,0,w,h);
  const d=imgData.data;
  // 先算灰度
  const gray=new Uint8Array(w*h);
  for(let i=0, j=0; i<d.length; i+=4, j++){
    gray[j]=Math.round(0.299*d[i]+0.587*d[i+1]+0.114*d[i+2]);
  }
  // 积分图
  const integral=new Int32Array((w+1)*(h+1));
  for(let y=0;y<h;y++){
    let rowSum=0;
    for(let x=0;x<w;x++){
      rowSum+=gray[y*w+x];
      integral[(y+1)*(w+1)+(x+1)]=integral[y*(w+1)+(x+1)]+rowSum;
    }
  }
  const half=Math.floor(blockSize/2);
  for(let y=0;y<h;y++){
    for(let x=0;x<w;x++){
      const x1=Math.max(0,x-half), y1=Math.max(0,y-half);
      const x2=Math.min(w-1,x+half), y2=Math.min(h-1,y+half);
      const count=(x2-x1+1)*(y2-y1+1);
      const sum=integral[(y2+1)*(w+1)+(x2+1)]-integral[(y1)*(w+1)+(x2+1)]-integral[(y2+1)*(w+1)+(x1)]+integral[(y1)*(w+1)+(x1)];
      const mean=sum/count;
      const idx=(y*w+x)*4;
      const v=gray[y*w+x] < (mean-C) ? 0 : 255;
      d[idx]=d[idx+1]=d[idx+2]=v; d[idx+3]=255;
    }
  }
  dstCtx.putImageData(imgData,0,0);
  return dst;
}
// 用 jsQR 解码单个 canvas
function _tryJsQR(canvas){
  try{
    if(typeof jsQR !== 'function') return null;
    const ctx=canvas.getContext('2d');
    const imgData=ctx.getImageData(0,0,canvas.width,canvas.height);
    const r=jsQR(imgData.data, imgData.width, imgData.height, {inversionAttempts:'attemptBoth'});
    return r && r.data ? {rawValue:r.data, format:'qr_code'} : null;
  }catch(e){ return null; }
}
// 用 jsQR 解码多个预处理变体，专门提升 PCB 标签/浅灰二维码/小码识别率
// 精简版（v2，2026-07-30）：从 30+ 变体砍到 12 变体，覆盖原图/180°/CLAHE/阈值，加 180° 旋转变体解决倒置QR
// 单次扫描总耗时从 ~9s 降到 ~2s（1280 长边 + 移动端 V8）
function _tryJsQRVariants(canvas){
  if(typeof jsQR !== 'function') return null;
  try{
    const gray=_makeGrayCanvas(canvas);
    const auto=_autoContrastCanvas(gray);
    // 180° 旋转变体：覆盖倒置QR（zxing-js 浏览器版不自动试 4 方向）
    const gray180=_flipCanvas(gray, 'hv');
    const auto180=_flipCanvas(auto, 'hv');
    const variants=[gray, gray180, auto, auto180];
    // PCB 浅灰模块需要高阈值（150-220）才能二值化为黑模块
    for(const th of [170, 190, 210, 230]){
      variants.push(_makeBinaryCanvas(gray, th));
      variants.push(_makeBinaryCanvas(gray180, th));
    }
    // CLAHE 局部直方图均衡：修复 PCB 浅灰/反光/低对比度二维码
    // （实测 Python 端 zxing-cpp 在 clahe3 变体上对反光白底 100% 命中）
    const cl3=_claheCanvas(gray, 3.0);
    variants.push(cl3);
    variants.push(_flipCanvas(cl3, 'hv'));
    // ── 小码专用变体（极小低对比度灰底码：中心裁剪→高倍放大→二值化）──
    // 用户常把设备标签放画面中央但 QR 仅占画面 5-8%，需要裁剪+放大让模块清晰
    for(const ratio of [0.5, 0.6]){
      const crop=_centerCropCanvas(canvas, ratio);
      const cg=_makeGrayCanvas(crop);
      const up3=_scaleCanvas(cg, 3);
      variants.push(_makeBinaryCanvas(up3, 170));
      variants.push(_makeBinaryCanvas(up3, 190));
    }
  }catch(e){}
  for(const v of variants){
    const r=_tryJsQR(v);
    if(r) return r;
  }
  return null;
}
// 用 ZXing 解码二维码（比 jsQR 更鲁棒，擅长 PCB 标签/低质量/反光场景）
function _tryZxing(canvas){
  return new Promise((resolve)=>{
    try{
      if(typeof ZXing === 'undefined' || !ZXing.BrowserQRCodeReader){ resolve(null); return; }
      const reader=new ZXing.BrowserQRCodeReader();
      const url=canvas.toDataURL('image/png');
      const t=setTimeout(()=>resolve(null), 3500);
      reader.decodeFromImageUrl(url)
        .then(result=>{
          clearTimeout(t);
          if(result && result.text!=null) resolve({rawValue:String(result.text), format:'qr_code'});
          else resolve(null);
        })
        .catch(e=>{ clearTimeout(t); resolve(null); });
    }catch(e){ resolve(null); }
  });
}
// ZXing 多预处理变体：把灰度/二值/CLAHE/180°翻转后的图像喂给 ZXing
// 精简版（v2，2026-07-30）：从 30+ 变体砍到 ~12 变体。
// 砍掉 3x 放大（服务端 4x 已覆盖）+ 9 个自适应阈值组合（保留 2 个）+ 1 个额外 CLAHE。
// 关键加 180° 旋转变体：zxing-js 浏览器版默认不试 4 方向，倒置QR 必须靠翻转换支持。
// 单次扫描总耗时从 ~12s 降到 ~2.5s（移动端 V8）
async function _tryZxingVariants(canvas){
  if(typeof ZXing === 'undefined' || !ZXing.BrowserQRCodeReader) return null;
  try{
    const gray=_makeGrayCanvas(canvas);
    const auto=_autoContrastCanvas(gray);
    // 180° 旋转变体
    const gray180=_flipCanvas(gray, 'hv');
    const auto180=_flipCanvas(auto, 'hv');
    const variants=[canvas, gray, gray180, auto, auto180];
    // 阈值变体（高阈值解决 PCB 浅灰模块）
    for(const th of [170, 190, 210]){
      variants.push(_makeBinaryCanvas(gray, th));
      variants.push(_makeBinaryCanvas(gray180, th));
    }
    // CLAHE 局部直方图均衡：反光/低对比度白底二维码
    const cl3=_claheCanvas(gray, 3.0);
    variants.push(_claheCanvas(gray, 2.0));
    variants.push(cl3);
    variants.push(_flipCanvas(cl3, 'hv'));
    // 自适应阈值（保留 2 个组合，覆盖浅灰模块最坏情况）
    variants.push(_adaptiveThresholdCanvas(gray, 51, 5));
    variants.push(_adaptiveThresholdCanvas(gray, 31, 10));
    // ── 小码专用变体（中心裁剪→高倍放大→CLAHE/原始）──
    for(const ratio of [0.5, 0.6]){
      const crop=_centerCropCanvas(canvas, ratio);
      const cg=_makeGrayCanvas(crop);
      variants.push(_scaleCanvas(cg, 3));       // 3x 放大原始灰度
      variants.push(_claheCanvas(_scaleCanvas(cg, 3), 3.0)); // 3x + CLAHE
    }
    for(const v of variants){
      const r=await _tryZxing(v);
      if(r) return r;
    }
  }catch(e){}
  return null;
}
// 用 Quagga2 解码一维条码兜底（纯 JS：Code128/39、EAN、UPC、ITF、Codabar 等）
function _tryQuagga(dataUrl, patchSize){
  return new Promise((resolve)=>{
    try{
      if(typeof Quagga === 'undefined' || !Quagga.decodeSingle){ resolve(null); return; }
      const readers=[
        'code_128_reader','code_39_reader','code_39_vin_reader',
        'ean_reader','ean_8_reader','ean_13_reader','ean_13_extended_reader',
        'upc_reader','upc_e_reader','itf_reader','codabar_reader','i2of5_reader'
      ];
      // patchSize: small/medium/large/x-large，不同大小条码用不同尺寸尝试
      const cfg={
        src:dataUrl,
        numOfWorkers:0,
        inputStream:{ size:1280 },
        locator:{ patchSize:(patchSize||'medium'), halfSample:false },
        decoder:{ readers:readers, multiple:false }
      };
      Quagga.decodeSingle(cfg, function(result){
        if(result && result.codeResult && result.codeResult.code){
          resolve({rawValue:String(result.codeResult.code), format:(result.codeResult.format||'1d')});
        }else{ resolve(null); }
      });
    }catch(e){ resolve(null); }
  });
}
// 尝试 BarcodeDetector.detect()，失败自动重试；彻底不可用也不抛错，交由上层继续 fallback
async function _detectWithFallback(det, canvas, retries=2){
  let lastErr='';
  for(let i=0;i<=retries;i++){
    try{
      const codes=await det.detect(canvas);
      if(codes && codes.length) return codes;
      await new Promise(r=>setTimeout(r,120));
    }catch(e){
      lastErr=(e && (e.message||String(e))) || '';
      if(i<retries) await new Promise(r=>setTimeout(r,300));
    }
  }
  // BarcodeDetector 失败后用 jsQR 兜底二维码；若连 jsQR 也没有也不抛错
  const qr=_tryJsQR(canvas);
  if(qr) return [qr];
  return [];
}
// 统一解码入口：二维码/一维码都试，不抛错
// 服务端强解码兜底：把图像（压缩为 jpeg，最长边 1280）发给 /api/unbind/qr-decode，
// 后端用本机 Python(zxing-cpp) 解出反光/低对比度白底二维码。失败静默返回 null（不阻塞主流程）。
async function _tryServerQr(canvas, dataUrl){
  try{
    let payload=dataUrl;
    // 转 jpeg 并限制最长边 1280，减小上行体积与解码耗时
    try{
      if(canvas && canvas.width){
        const MAX=1280;
        const w=canvas.width, h=canvas.height;
        const sc=Math.min(1, MAX/Math.max(w||1,h||1));
        const c=document.createElement('canvas');
        if(sc<1){ c.width=Math.round(w*sc); c.height=Math.round(h*sc); }
        else { c.width=w; c.height=h; }
        c.getContext('2d').drawImage(canvas,0,0,c.width,c.height);
        payload=c.toDataURL('image/jpeg',0.9);
      }
    }catch(_){ /* 失败则退回原 dataUrl */ }

    // 首次尝试：完整图像
    const r1=await _serverQrPost(payload);
    if(r1) return r1;

    // 二次尝试：中心裁剪 50%（小码放大后 zxing-cpp 更容易锁定 finder pattern）
    // 仅当 canvas 可用且首次失败时触发（避免正常码的双重开销）
    if(canvas && canvas.width && canvas.height){
      try{
        const crop=_centerCropCanvas(canvas, 0.5);
        const cropPayload=crop.toDataURL('image/jpeg',0.9);
        const r2=await _serverQrPost(cropPayload);
        if(r2) return r2;
      }catch(_){ /* 裁剪失败则跳过 */ }
    }
    return null;
  }catch(e){ return null; }
}

// 服务端 POST 请求封装（复用超时/错误处理）
async function _serverQrPost(payload){
  const ctrl=new AbortController();
  const timer=setTimeout(()=>ctrl.abort(), 5000);
  try{
    const resp=await fetch('/api/unbind/qr-decode',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({image:payload}),
      signal:ctrl.signal
    });
    clearTimeout(timer);
    if(!resp.ok) return null;
    const j=await resp.json();
    if(j && j.text) return { rawValue: String(j.text).trim() };
    return null;
  }catch(e){
    clearTimeout(timer);
    return null;
  }
}
// 竞速原语：并发执行多个解码 promise，返回【第一个解出非空结果】的，全部为空才返回 null。
// 对标微信「检测先行 + 服务端强解码」并行思路：端侧 BarcodeDetector 与服务端 zxing-cpp 同时跑，
// 谁先解出用谁（典型 ~200ms），避免串行等待拖慢体验。
function _raceFirstSuccess(promises){
  return new Promise((resolve)=>{
    let pending=promises.length, settled=false;
    for(const p of promises){
      Promise.resolve(p).then(r=>{
        if(r && !settled){ settled=true; resolve(r); }
        else { pending--; if(pending===0 && !settled) resolve(null); }
      }).catch(()=>{ pending--; if(pending===0 && !settled) resolve(null); });
    }
    if(pending===0 && !settled) resolve(null);
  });
}
async function _decodeImage(canvas, dataUrl){
  const _t0=performance.now();
  // 总时间预算 4s：超出后停止再试（剩余环节不再跑），让用户尽快看到失败提示而非一直卡住
  const _budget=4000;
  const _over=()=>(performance.now()-_t0)>_budget;
  if(_setScanMsg) _setScanMsg('正在识别…');
  // 微信式「检测先行 + 服务端强解码」并行竞速（典型 ~200ms）：
  // ① 端侧 BarcodeDetector（最快，清晰码秒解）② 服务端 zxing-cpp（200ms，4 方向旋转不变，反光/小码鲁棒）
  // 两者谁先解出用谁；均失败才退化为浏览器暴力枚举（离线/服务端不可达兜底）
  const fast=_raceFirstSuccess([
    _detectWithFallback(_makeBarcodeDetector(), canvas, 1)
      .then(codes=>(codes && codes.length)?codes[0]:null).catch(()=>null),
    _tryServerQr(canvas, dataUrl).catch(()=>null)
  ]);
  const fastR=await fast;
  if(fastR) return fastR;
  if(_over()) return null;
  // —— 以下为离线/服务端不可达兜底：浏览器暴力枚举（含 180° 旋转变体）——
  // 2) jsQR 多预处理变体（含 180° 旋转变体覆盖倒置QR）
  const jsqrCode=_tryJsQRVariants(canvas);
  if(jsqrCode) return jsqrCode;
  if(_over()) return null;
  // 3) ZXing：鲁棒二维码解码，擅长 PCB 标签/反光/小码（含 180° 旋转变体）
  const zxingCode=await _tryZxingVariants(canvas);
  if(zxingCode) return zxingCode;
  if(_over()) return null;
  // 4) 一维条码 Quagga2：仅在上述全失败时跑（1D 条码概率低，单 patchSize 即可）
  if(_setScanMsg) _setScanMsg('服务端无法识别，尝试一维条码…');
  const q=await _tryQuagga(dataUrl, 'medium');
  if(q) return q;
  return null;
}
function _setScanMsg(t){ if(_scanMsgEl) _scanMsgEl.textContent=t; }
// 内网 http 降级：调用系统相机拍照 → BarcodeDetector 静态解码（不受安全上下文限制）
function scanByPhoto(targetId){
  const inp=document.createElement('input');
  inp.type='file'; inp.accept='image/*'; inp.setAttribute('capture','environment');
  inp.style.display='none';
  document.body.appendChild(inp);
  inp.onchange=async ()=>{
    const f=inp.files && inp.files[0];
    if(inp.parentNode) inp.parentNode.removeChild(inp);
    if(!f) return;
    // 至少有一个纯 JS 解码库（jsQR/Quagga/ZXing）可用即可；都没加载再提示
    const hasZxing=typeof ZXing !== 'undefined' && !!ZXing.BrowserQRCodeReader;
    if(typeof jsQR !== 'function' && (typeof Quagga === 'undefined' || !Quagga.decodeSingle) && !hasZxing){
      toast('扫码解码库未加载，请彻底清除浏览器缓存后重试');
      return;
    }
    const url=URL.createObjectURL(f);
    const img=new Image();
    img.onload=async ()=>{
      try{
        const c=document.createElement('canvas');
        // 手机照片常 2000px+，先缩到最长边 1280 提升识别率与速度
        const MAX=1280;
        let w=img.naturalWidth, h=img.naturalHeight;
        const sc=Math.min(1, MAX/Math.max(w||1,h||1));
        w=Math.round((w||1)*sc); h=Math.round((h||1)*sc);
        c.width=w; c.height=h;
        c.getContext('2d').drawImage(img,0,0,w,h);
        const dataUrl=c.toDataURL();
        URL.revokeObjectURL(url);
        const code=await _decodeImage(c, dataUrl);
        if(code){ _fillScanResult(code,targetId); }
        else{ toast('未识别到二维码/条码，请对准清晰后重拍，或手动输入'); }
      }catch(e){ toast('解码失败：'+((e&&e.message)?e.message:e)); }
    };
    img.onerror=()=>{ URL.revokeObjectURL(url); toast('图片读取失败，请重试'); };
    img.src=url;
  };
  inp.click();
}
function _fillScanResult(code,targetId){
  const val=(code && (code.rawValue||'')).trim();
  const el=document.getElementById(targetId || _scanTarget);
  if(el) el.value=val;
  toast('已识别：'+(val.length>24?val.slice(0,24)+'…':val));
  closeScan();
}
async function scanCapture(){
  if(!_scanStream || !_scanDet){ toast('相机未就绪，请稍后再试'); return; }
  const v=document.getElementById('scanVideo');
  if(!v || !v.videoWidth){ toast('画面未就绪，请稍等'); return; }
  const capBtn=document.getElementById('scanCapture');
  if(capBtn) capBtn.disabled=true;
  _setScanMsg('正在识别…');
  try{
    if(!_scanCanvas){ _scanCanvas=document.createElement('canvas'); }
    // 拍照后先缩到最长边 1280 再解码——CLAHE/jsQR/ZXing 全是 O(npix)，
    // 2000x2000 拍照图会让变体循环跑 9-15s，1280 是识别率与速度的最佳平衡点
    const MAX=1280;
    let w=v.videoWidth, h=v.videoHeight;
    const sc=Math.min(1, MAX/Math.max(w||1,h||1));
    w=Math.round((w||1)*sc); h=Math.round((h||1)*sc);
    _scanCanvas.width=w; _scanCanvas.height=h;
    _scanCanvas.getContext('2d').drawImage(v,0,0,w,h);
    const dataUrl=_scanCanvas.toDataURL('image/jpeg', 0.9);
    const code=await _decodeImage(_scanCanvas, dataUrl);
    if(code){ _fillScanResult(code); }
    else{ _setScanMsg('未识别到，请对准后再次点击「拍照识别」'); }
  }catch(e){ _setScanMsg('识别失败：'+((e&&e.message)?e.message:e)); }
  finally{ if(capBtn) capBtn.disabled=false; }
}
async function openScan(targetId){
  // 非安全上下文（内网 http 访问）→ 走系统相机拍照解码，内网也能扫码
  if(!window.isSecureContext || !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    return scanByPhoto(targetId);
  }
  const det=_makeBarcodeDetector();
  if(!det){ toast('当前浏览器不支持扫码，请手动输入，或改用安卓端 Chrome/Edge'); return; }
  _scanDet=det; _scanTarget=targetId;
  const modal=document.getElementById('scanModal');
  _scanMsgEl=document.getElementById('scanMsg');
  const capBtn=document.getElementById('scanCapture');
  _setScanMsg('将二维码/条码放入框内…');
  if(capBtn){ capBtn.disabled=false; capBtn.onclick=scanCapture; }
  modal.classList.add('show');
  try{
    // 安卓：尽量要后置摄像头、高分辨率、连续对焦
    _scanStream=await navigator.mediaDevices.getUserMedia({
      video:{
        facingMode:{ideal:'environment'},
        width:{ideal:1920}, height:{ideal:1080},
        focusMode:{ideal:'continuous'}
      },
      audio:false
    });
    const v=document.getElementById('scanVideo');
    v.srcObject=_scanStream; v.setAttribute('playsinline',''); v.setAttribute('webkit-playsinline','');
    await v.play();
    _setScanMsg('识别中… 若未自动识别，请点击「拍照识别」');
    if(!_scanCanvas) _scanCanvas=document.createElement('canvas');
    let last=0, busy=false;
    const tick=async ()=>{
      if(!_scanStream) return;
      const now=performance.now();
      if(!busy && now-last>=250 && v.videoWidth && v.readyState>=2){
        busy=true; last=now;
        try{
          _scanCanvas.width=v.videoWidth; _scanCanvas.height=v.videoHeight;
          _scanCanvas.getContext('2d').drawImage(v,0,0,_scanCanvas.width,_scanCanvas.height);
          const codes=await _detectWithFallback(_scanDet,_scanCanvas,1);
          if(codes && codes.length){ _fillScanResult(codes[0]); return; }
        }catch(e){ /* 单帧失败继续 */ }
        finally{ busy=false; }
      }
      _scanTimer=setTimeout(tick,80);
    };
    tick();
  }catch(e){
    _setScanMsg('无法打开相机：'+((e&&e.message)?e.message:e));
  }
}
function closeScan(){
  if(_scanTimer){ clearTimeout(_scanTimer); _scanTimer=null; }
  if(_scanStream){ _scanStream.getTracks().forEach(t=>t.stop()); _scanStream=null; }
  const modal=document.getElementById('scanModal');
  if(modal) modal.classList.remove('show');
  _setScanMsg('将二维码/条码放入框内…');
}

