async function dhSubmitAdd(){
  const date = ($('#dhADate').value || '').trim();
  const line = ($('#dhALine').value || '').trim();
  const model = ($('#dhAModel').value || '').trim();
  const reason = ($('#dhAReason').value || '').trim();
  const qty = ($('#dhAQty').value || '').trim();
  const stage = ($('#dhAStage').value || '').trim();
  const handle = ($('#dhAHandle').value || '').trim();
  if(!date){ toast('请填写日期'); return; }
  if(!model){ toast('请填写型号'); return; }
  if(!reason){ toast('请填写问题原因'); return; }
  const fd = new FormData();
  fd.append('date', date); fd.append('line', line);
  fd.append('model', model); fd.append('reason', reason); fd.append('qty', qty);
  fd.append('stage', stage); fd.append('handle', handle);
  // 上传已标注图片（优先 baked，否则原始）；提交后清空已上传文件（含标注图）
  dhAddFiles.forEach(it => fd.append('image', it.baked || it.file));
  const btn = $('#dhABtn'); btn.disabled = true; btn.textContent = '提交中…';
  try{
    const r = await (await fetch(dhAPI('add'), { method:'POST', body: fd })).json();
    if(r.ok){
      // 新线别/发生工程/处理方式 → 自动录入下拉选项（localStorage 持久化 + 内存即时生效）
      if (line && dhLineOpts.indexOf(line) < 0) dhLineOpts.push(line);
      if (stage && dhStageOpts.indexOf(stage) < 0) dhStageOpts.push(stage);
      if (handle && dhHandleOpts.indexOf(handle) < 0) dhHandleOpts.push(handle);
      dhLocalAdd('lines', line); dhLocalAdd('stages', stage); dhLocalAdd('handles', handle);
      // 清空已上传文件（含已标注图，避免重复提交）
      dhAddFiles.forEach(it => { if (it.bakedUrl) URL.revokeObjectURL(it.bakedUrl); if (it.url) URL.revokeObjectURL(it.url); });
      dhAddFiles = [];
      // 清空文件输入框
      const fi = $('#dhAImg'); if (fi) fi.value = '';
      toast('录入成功（已按日期排序写入汇总表' + (r.images ? '，含 ' + r.images + ' 图' : '') + '）');
      dhPageAdd();
    } else toast('录入失败：' + (r.error || '未知错误'));
  }catch(e){ toast('录入失败：' + (e.message || e)); }
  finally{ btn.disabled = false; btn.textContent = '💾 提交录入'; }
}

