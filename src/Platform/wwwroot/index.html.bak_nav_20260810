}

function unbindRenderUsageLog(container, log){
  if (!log) log = [];
  if (!log.length){
    container.innerHTML = '<div class="unbind-empty" style="padding:60px 0">暂无使用记录</div>';
    return;
  }
  const actLabel = { search:'🔍 搜索', outer:'📦 外箱解绑', repair:'🔧 维修解绑' };
  container.innerHTML = '<div class="usage-log">' +
    log.map(e=>{
      const d = new Date(e.ts);
      const M = String(d.getMonth()+1).padStart(2,'0');
      const D = String(d.getDate()).padStart(2,'0');
      const h = String(d.getHours()).padStart(2,'0');
      const m = String(d.getMinutes()).padStart(2,'0');
      const ts = `${M}-${D} ${h}:${m}`;
      const badge = e.result==='success'
        ? '<span class="usage-badge ok">成功</span>'
        : '<span class="usage-badge fail">失败</span>';
      let pdesc = '';
      if (e.action === 'search'){
        const p = e.params || {};
        const parts = [];
        if (p.coverCode) parts.push('上盖:' + p.coverCode);
        if (p.bigCode) parts.push('大板:' + p.bigCode);
        if (p.smallCode) parts.push('小板:' + p.smallCode);
        if (p.boxCode) parts.push('外箱:' + p.boxCode);
        pdesc = parts.join('，') || '(无参数)';
      } else {
        pdesc = '选中 ' + (e.count||0) + ' 条';
      }
      return `<div class="usage-item">
        <div class="usage-ic">${esc((actLabel[e.action]||'📋').slice(0,2))}</div>
        <div class="usage-body">
          <div class="usage-head">
            <span class="usage-act">${esc(actLabel[e.action]||e.action)}</span>
            ${badge}
            <span class="usage-time">${ts}</span>
          </div>
          <div class="usage-desc">${esc(pdesc)} → ${esc(e.detail||'')}</div>
        </div>
      </div>`;
    }).join('') +
    '</div>' +
    '<div class="usage-clear" id="ubUsageClear">🗑️ 清空使用记录</div>';
  const clr = container.querySelector('#ubUsageClear');
  if (clr) clr.onclick = async ()=>{
    if (confirm('确定清空全部使用记录吗？')){
      await unbindClearUsageLog();
      const fresh = await unbindGetUsageLog();
      unbindRenderUsageLog(container, fresh);
      toast('已清空使用记录');
    }
  };
}

// ---- 搜索 ----
async function unbindSearch(){
  const v = unbindGetValues();
  if (!v.coverCode && !v.bigCode && !v.smallCode && !v.boxCode){
    toast('请至少输入上盖码、大板码、小板码或外箱码其中一个');
    return;
  }
  window.__ubSel = new Set();
  unbindSetLoading('查询中…');
  try{
    const r = await unbindFetch('api/unbind/search', Object.assign({ page:1, limit:200 }, v));
    const list = unbindExtractList(r);
    if (!list.length){
      $('#ubList').innerHTML = '<div class="unbind-empty">未找到匹配记录</div>';
      toast('未找到匹配记录');
      unbindLogUsage('search', v, 'fail', '未找到匹配记录', 'no_data', 0);
    } else {
      unbindRenderList(list);
      toast(`查询到 ${list.length} 条记录，可勾选后解绑`);
      unbindLogUsage('search', v, 'success', `查询到 ${list.length} 条记录`, null, list.length);
    }
  }catch(err){
    if (err.cls){
      unbindShowError(err);
      toast(err.title);
      unbindLogUsage('search', v, 'fail', err.title, err.type, 0);
    } else {
      $('#ubList').innerHTML = '<div class="unbind-empty">查询失败：' + esc(err.message || err) + '</div>';
      toast('查询失败');
      unbindLogUsage('search', v, 'fail', err.message || '未知错误', 'unknown', 0);
    }
  }
}

// ---- 解绑（外箱 / 维修）----
async function unbindDo(type, label){
  const ids = Array.from(window.__ubSel || []);
  if (!ids.length){
    toast('请先搜索并勾选要解绑的记录');
    return;
  }
  if (!confirm(`确定对选中的 ${ids.length} 条记录执行「${label}」吗？`)) return;
  unbindSetLoading(label + '中…');
  const key = type === 'outer' ? 'outer' : 'repair';
  try{
    const r = await unbindFetch('api/unbind/' + key, { ids });
    toast(r.msg || r.message || (label + '成功'));
    window.__ubSel = new Set();
    $('#ubList').innerHTML = '<div class="unbind-empty">操作成功，列表已清空（可重新搜索）</div>';
    unbindLogUsage(type, { count: ids.length }, 'success', r.msg || r.message || (label + '成功'), null, ids.length);
  }catch(err){
    if (err.cls){
      unbindShowError(err);
      toast(err.title);
      unbindLogUsage(type, { count: ids.length }, 'fail', err.title, err.type, ids.length);
    } else {
      $('#ubList').innerHTML = '<div class="unbind-empty">' + label + '失败：' + esc(err.message || err) + '</div>';
      toast(label + '失败');
      unbindLogUsage(type, { count: ids.length }, 'fail', err.message || '未知错误', 'unknown', ids.length);
    }
  }
}
async function unbindOuter(){ await unbindDo('outer','外箱解绑'); }
async function unbindRepair(){ await unbindDo('repair','维修解绑'); }

