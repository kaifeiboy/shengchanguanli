  }).join('');

  box.querySelectorAll('.unbind-item').forEach((card)=>{
    const id = card.dataset.id;
    const chk = card.querySelector('input[type=checkbox]');
    const toggle = ()=>{
      if (window.__ubSel.has(id)) window.__ubSel.delete(id); else window.__ubSel.add(id);
      card.classList.toggle('sel');
      if (chk) chk.checked = window.__ubSel.has(id);
    };
    if (chk) chk.onchange = ()=>{
      if (chk.checked) window.__ubSel.add(id); else window.__ubSel.delete(id);
      card.classList.toggle('sel', chk.checked);
    };
    card.onclick = (e)=>{ if (e.target !== chk) toggle(); };
  });
}

// ---- 错误分类：根据 HTTP 状态码和响应体，区分不同故障原因 ----
function unbindClassifyError(status, body){
  const title = (body && (body.title || body.msg || body.message)) || '';
  const detail = (body && (body.detail || body.msg || body.message)) || '';
  if (status === 401)
    return { type:'auth', icon:'🔑', cls:'e-auth', title:'鉴权过期',
      detail:'目标系统登录已过期。平台正在尝试自动重新登录并刷新令牌，请稍候重试；若持续失败，请到「更多→解绑账号」确认账号配置无误。' };
  if (status === 502){
    if (title.includes('无法连接中转服务') || detail.includes('Node.js 中转服务'))
      return { type:'proxy', icon:'🔌', cls:'e-proxy', title:'中转服务未启动',
        detail:'本地中转服务(端口5001)未运行，请检查服务器是否正常开机或联系管理员。' };
    if (detail.includes('超时') || detail.includes('timeout'))
      return { type:'timeout', icon:'⏱️', cls:'e-timeout', title:'请求超时',
        detail:'目标系统响应超过 30 秒，可能网络拥堵或目标系统异常，请稍后重试。' };
    if (detail.includes('连接目标系统失败') || detail.includes('ECONNREFUSED') || detail.includes('ENOTFOUND'))
      return { type:'target', icon:'📡', cls:'e-target', title:'目标系统不可达',
        detail: detail || '无法连接到目标内网系统，请检查网络连通性。' };
    return { type:'target', icon:'📡', cls:'e-target', title:'目标系统不可达',
      detail: detail || title || '无法连接到目标内网系统，请检查网络。' };
  }
  if (status >= 500)
    return { type:'server', icon:'⚙️', cls:'e-server', title:'服务器内部错误',
      detail: detail || title || '后端处理异常，请稍后重试或联系管理员。' };
  return { type:'network', icon:'📡', cls:'e-network', title:'网络不通',
    detail:'无法连接到服务器，请检查 Wi-Fi 或网络连接是否正常。' };
}

function unbindShowError(err){
  $('#ubList').innerHTML = `<div class="unbind-error ${err.cls}">
    <span class="ue-icon">${err.icon}</span>
    <span class="ue-title">${esc(err.title)}</span>
    <span class="ue-detail">${esc(err.detail)}</span>
  </div>`;
}

// ---- 统一 fetch 封装：处理 HTTP 状态码 + 代理错误 ----
async function unbindFetch(url, bodyObj){
  let resp;
  try{
    resp = await fetch(url, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(bodyObj)
    });
  }catch(e){
    throw { type:'network', icon:'📡', cls:'e-network', title:'网络不通',
      detail:'无法连接到服务器，请检查 Wi-Fi 或网络连接。(' + (e.message||e) + ')' };
  }
  const raw = await resp.text();
  let body = null;
  try{ body = JSON.parse(raw); }catch(_){ /* 非 JSON 响应 */ }
  if (!resp.ok) throw unbindClassifyError(resp.status, body);
  // resp.ok=true 但代理可能返回 {code:-1, msg:"连接目标系统失败：..."}
  if (body && body.code !== undefined && body.code !== 0 && body.code !== 200){
    const msg = body.msg || body.message || '未知错误';
    if (msg.includes('超时') || msg.includes('timeout'))
      throw { type:'timeout', icon:'⏱️', cls:'e-timeout', title:'请求超时', detail: msg };
    if (msg.includes('连接目标系统失败') || msg.includes('ECONNREFUSED') || msg.includes('ENOTFOUND'))
      throw { type:'target', icon:'📡', cls:'e-target', title:'目标系统不可达', detail: msg };
    throw { type:'server', icon:'⚠️', cls:'e-server', title:'操作失败', detail: msg };
  }
  return body;
}

// ---- 使用记录（服务端持久化，最多 30 条，超出自动删除最旧）----
// 改为服务端存储，避免手机浏览器 localStorage 被 WebView / 隐私模式 / 存储回收静默清空
const USAGE_LOG_MAX = 30;

function unbindLogUsage(action, params, result, detail, errorType, count){
