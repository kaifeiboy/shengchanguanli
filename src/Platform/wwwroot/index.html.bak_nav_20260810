}

async function unbindGetUsageLog(){
  try{
    const r = await fetch('api/unbind/usage-log');
    if (!r.ok) return [];
    const arr = await r.json();
    return Array.isArray(arr) ? arr : [];
  }catch(_){ return []; }
}

async function unbindClearUsageLog(){
