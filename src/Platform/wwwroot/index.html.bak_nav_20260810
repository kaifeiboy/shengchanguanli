  if(!model){ toast('请填写型号'); return; }
  if(!reason){ toast('请填写问题原因'); return; }
  const fd = new FormData();
  fd.append('date', date); fd.append('line', line);
  fd.append('model', model); fd.append('reason', reason); fd.append('qty', qty);
  fd.append('stage', stage); fd.append('handle', handle);
  const files = $('#dhAImg').files;
  for(let i=0;i<files.length;i++) fd.append('image', files[i]);
  const btn = $('#dhABtn'); btn.disabled = true; btn.textContent = '提交中…';
  try{
    const r = await (await fetch(dhAPI('add'), { method:'POST', body: fd })).json();
    if(r.ok){
      // 新线别/发生工程/处理方式 → 自动录入下拉选项（localStorage 持久化 + 内存即时生效）
      if (line && dhLineOpts.indexOf(line) < 0) dhLineOpts.push(line);
      if (stage && dhStageOpts.indexOf(stage) < 0) dhStageOpts.push(stage);
      if (handle && dhHandleOpts.indexOf(handle) < 0) dhHandleOpts.push(handle);
      dhLocalAdd('lines', line); dhLocalAdd('stages', stage); dhLocalAdd('handles', handle);
