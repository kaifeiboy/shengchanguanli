// 单条录入下拉选项（线别/发生工程/处理方式）：服务端 meta（数据去重 + 默认项）∪ localStorage（手动新增持久化）
let dhLineOpts = [], dhStageOpts = [], dhHandleOpts = [];
function dhLocalGet(k){ try{ return JSON.parse(localStorage.getItem('dh_' + k) || '[]'); }catch(e){ return []; } }
function dhLocalAdd(k, v){
  if(!v) return;
  const arr = dhLocalGet(k);
  if(arr.indexOf(v) < 0){ arr.push(v); try{ localStorage.setItem('dh_' + k, JSON.stringify(arr)); }catch(e){} }
}
function dhMergeOpts(base, local){
  const seen = {}; (base||[]).concat(local||[]).forEach(o => { if(o) seen[o] = 1; });
  return Object.keys(seen);
}
function dhLoadDropOpts(){
  if (dhLineOpts.length && dhStageOpts.length && dhHandleOpts.length) return Promise.resolve();
  return fetch(dhAPI('meta')).then(r=>r.json()).then(m => {
    dhLineOpts = dhMergeOpts(m.lines||[], dhLocalGet('lines'));
    dhStageOpts = dhMergeOpts(m.stages||[], dhLocalGet('stages'));
    dhHandleOpts = dhMergeOpts(m.handles||[], dhLocalGet('handles'));
  }).catch(()=>{});
}
// 通用自定义下拉：点击/输入展开、过滤、支持"使用新值"、点外部关闭（手机端兼容，替代 datalist）
function dhInitDropdown(cfg){
  const input = $(cfg.input), list = $(cfg.list), btn = $(cfg.btn);
  const close = () => { list.style.display = 'none'; };
  const render = () => {
    const q = (input.value || '').trim();
    const opts = (cfg.options() || []).slice();
    let items;
    if (q){
      const ql = q.toLowerCase();
      const match = opts.filter(o => o.toLowerCase().indexOf(ql) >= 0);
      items = match.map(o => `<div class="dh-dd-item" data-v="${esc(o)}">${esc(o)}</div>`);
      if (match.indexOf(q) < 0) items.unshift(`<div class="dh-dd-item new" data-v="${esc(q)}">使用「${esc(q)}」</div>`);
    } else {
      items = opts.map(o => `<div class="dh-dd-item" data-v="${esc(o)}">${esc(o)}</div>`);
    }
    if (!items.length) items = ['<div class="dh-dd-item" style="color:var(--sub);">无选项</div>'];
    list.innerHTML = items.join('');
  };
  const open = () => { render(); list.style.display = 'block'; };
  input.addEventListener('focus', open);
  input.addEventListener('input', () => { render(); list.style.display = 'block'; });
  btn.addEventListener('click', e => { e.stopPropagation(); if (list.style.display === 'block') close(); else open(); });
  list.addEventListener('click', e => {
    const it = e.target.closest('.dh-dd-item'); if (!it) return;
    const v = it.getAttribute('data-v');
    if (v) input.value = v;
    close();
  });
  document.addEventListener('click', e => { if (!e.target.closest('.dh-dd')) close(); });
}

