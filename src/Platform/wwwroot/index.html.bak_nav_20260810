<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>打标首件比对</title>
<script src="jsqr.js?v=3"></script>
<script src="quagga.min.js?v=2"></script>
<script src="zxing-library.min.js?v=1"></script>
<style>
  :root{
    --bg:#f0f4f8; --txt:#1a2332; --sub:#6b7a8a;
    --card:#ffffff; --line:#e2e8f0; --pri:#2c6feb;
    --ok:#16a34a; --warn:#d97706; --bad:#dc2626;
    --radius:14px;
    --ele1:0 2px 8px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.04);
    --ele2:0 4px 16px rgba(44,111,235,.15), 0 2px 4px rgba(44,111,235,.08);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--txt);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",sans-serif;}
  body{min-height:100vh;background-image:radial-gradient(ellipse at 50% 0%, rgba(44,111,235,.04) 0%, transparent 60%);}
  .wrap{max-width:540px;margin:0 auto;padding:0 6px 20px;display:flex;flex-direction:column;min-height:100vh;}

  /* 顶部行：模块功能标签栏（左）+ 更多按钮（右）同一水平线 */
  .top-bar{display:flex;align-items:center;gap:8px;padding:12px 8px 4px;flex:none;}
  /* 顶栏 - 模块大标题（置于标签栏下方，居中） */
  header.top{text-align:center;padding:8px 0 6px;flex:none;}
  header.top h1{font-size:22px;font-weight:800;letter-spacing:1.4px;color:var(--txt);margin:0;
    background:linear-gradient(135deg, var(--txt) 0%, var(--pri) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;display:inline-block;}
  header.top .top-sub{font-size:13px;color:var(--sub);margin-top:4px;letter-spacing:2px;}
  .more-btn{flex:none;margin-left:auto;display:inline-flex;align-items:center;justify-content:center;
    width:36px;height:36px;border-radius:50%;background:var(--card);border:1px solid var(--line);color:var(--sub);font-size:18px;font-weight:700;cursor:pointer;box-shadow:var(--ele1);}
  .more-btn:active{transform:scale(.93);}

  .hide{display:none !important;}

  /* 模块功能标签栏（顶部行左侧，占满、可横向滚动） */
  .mod-tabs{flex:1;min-width:0;display:flex;gap:10px;overflow-x:auto;padding:4px 0;-webkit-overflow-scrolling:touch;}
  .mod-tab{flex:none;padding:9px 16px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--txt);font-size:14px;font-weight:700;cursor:pointer;white-space:nowrap;box-shadow:var(--shadow);}
  .mod-tab.active{background:var(--pri);color:#fff;border-color:var(--pri);}

  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:18px;margin-bottom:14px;box-shadow:var(--ele1);}
  .card h3{margin:0 0 12px;font-size:16px;display:flex;align-items:center;gap:8px;color:var(--txt);}
  .card h3 .em{font-size:18px;}


  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;
    padding:13px 16px;border:none;border-radius:12px;font-size:15px;font-weight:700;color:#fff;
    background:var(--pri);cursor:pointer;transition:.18s;}
  .btn:active{transform:scale(.98);opacity:.92;}
  .btn.ghost{background:#fff;border:1px solid var(--line);color:var(--txt);font-weight:600;}
  .btn.sm{width:auto;padding:9px 14px;font-size:13px;}
  .btn.block-blue{background:var(--pri);color:#fff;}

  .entry-row{display:flex;gap:12px;}
  .entry{flex:1;display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line);
    border-radius:var(--radius);padding:16px;box-shadow:var(--ele1);cursor:pointer;transition:.18s;}
  .entry:active{transform:scale(.98);border-color:var(--pri);}
  .entry .e-ic{font-size:24px;}
  .entry .e-t{font-size:14px;font-weight:700;color:var(--txt);}
  .entry .e-s{font-size:11.5px;color:var(--sub);margin-top:2px;}

  .bar{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
  .back{font-size:13px;color:var(--pri);cursor:pointer;padding:7px 12px;border:1px solid var(--line);
    border-radius:10px;background:var(--card);font-weight:600;}
  .back:active{transform:scale(.97);}

  /* 🆕 立体功能按钮 - 大图标居中 */
  .feat-btn{display:flex;flex-direction:column;align-items:center;gap:12px;cursor:pointer;transition:.2s;}
  .feat-btn:active{transform:scale(.93);}
  .feat-btn .feat-ic{width:76px;height:76px;border-radius:20px;display:flex;align-items:center;justify-content:center;
    font-size:34px;color:#fff;position:relative;overflow:hidden;
    border:1px solid rgba(255,255,255,.25);}
  .feat-btn .feat-ic::after{content:'';position:absolute;top:0;left:0;right:0;height:45%;
    background:linear-gradient(180deg,rgba(255,255,255,.4) 0%,rgba(255,255,255,0) 100%);
    border-radius:20px 20px 0 0;pointer-events:none;}
  .feat-btn.feat-l .feat-ic{width:100px;height:100px;border-radius:26px;font-size:44px;}
  .feat-btn.feat-l .feat-ic::after{border-radius:26px 26px 0 0;}
  .feat-btn .feat-lb{font-size:14px;font-weight:600;color:var(--txt);letter-spacing:.5px;}
  .feat-btn.feat-l .feat-lb{font-size:17px;font-weight:700;}

  label.fld{display:block;font-size:12.5px;color:var(--sub);margin:0 0 6px;}
  input[type=text]{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--line);
    background:#fff;color:var(--txt);font-size:15px;outline:none;}
  input[type=text]:focus{border-color:var(--pri);}

  /* 自定义下拉（手机端兼容：datalist 在多数移动浏览器不可用） */
  .dh-dd{position:relative;width:100%;}
  .dh-dd input{padding-right:34px;}
  .dh-dd-btn{position:absolute;right:4px;top:50%;transform:translateY(-50%);
    width:28px;height:28px;border:none;background:transparent;color:var(--sub);
    font-size:14px;cursor:pointer;line-height:1;border-radius:8px;}
  .dh-dd-btn:active{background:#eef2f7;}
  .dh-dd-list{position:absolute;left:0;right:0;top:calc(100% + 4px);z-index:60;
    background:#fff;border:1px solid var(--line);border-radius:12px;
    max-height:220px;overflow:auto;box-shadow:0 8px 24px rgba(15,23,42,.12);}
  .dh-dd-item{padding:11px 14px;font-size:14.5px;color:var(--txt);cursor:pointer;
    border-bottom:1px solid #f1f5f9;}
  .dh-dd-item:last-child{border-bottom:none;}
  .dh-dd-item:active,.dh-dd-item.sel{background:#eef4ff;color:var(--pri);}
  .dh-dd-item.new{color:var(--pri);font-weight:600;}

  .up-row{display:flex;gap:12px;margin-bottom:4px;}
  .up-card{display:flex;flex-direction:column;align-items:center;gap:6px;
    flex:1;border:1.5px solid var(--line);border-radius:14px;padding:16px 10px;color:var(--sub);
    font-size:12px;text-align:center;background:#fff;transition:.18s;cursor:pointer;}
  .up-card:active,.up-card:hover{border-color:var(--pri);background:#f5f8ff;}
  .up-card input{display:none;}
  .up-card .big{font-size:28px;}
  .up-card b{color:var(--txt);font-size:14px;font-weight:700;}

  .list{max-height:52vh;overflow:auto;margin-top:4px;}
  .item{display:flex;align-items:center;gap:12px;padding:12px;border-radius:12px;
    background:#fff;border:1px solid var(--line);margin-bottom:10px;cursor:pointer;transition:.18s;}
  .item:active{transform:scale(.99);border-color:var(--pri);background:#f5f8ff;}
  .item .meta{flex:1;min-width:0;}
  .item .fn{font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--txt);}
  .item .md{font-size:12px;color:var(--sub);margin-top:3px;}
  .tag{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11px;margin-left:6px;}
  .tag.ok{background:rgba(22,163,74,.12);color:var(--ok);}
  .tag.part{background:rgba(217,119,6,.12);color:var(--warn);}
  .tag.lan{background:rgba(37,99,235,.12);color:var(--pri);}
  .tag.ext{background:rgba(37,99,235,.10);color:var(--pri);}
  .empty{color:var(--sub);font-size:13px;text-align:center;padding:18px 0;}
  .meta-line{font-size:12.5px;color:var(--sub);margin:2px 0;}
  .meta-line b{color:var(--txt);}

  .spinner{width:18px;height:18px;border:2.5px solid rgba(31,41,55,.18);border-top-color:var(--pri);
    border-radius:50%;animation:spin .7s linear infinite;display:inline-block;vertical-align:-3px;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .toast{position:fixed;left:50%;bottom:30px;transform:translateX(-50%);background:#ffffff;
    border:1px solid var(--line);color:var(--txt);padding:11px 18px;border-radius:12px;font-size:13.5px;
    box-shadow:0 4px 16px rgba(0,0,0,.12);z-index:99;opacity:0;transition:.25s;pointer-events:none;max-width:90vw;font-weight:600;}
  .toast.show{opacity:1;}
  footer{text-align:center;color:var(--sub);font-size:11px;margin-top:10px;}

  /* 选图纸 底部弹层 */
  .overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:50;opacity:0;visibility:hidden;transition:.25s;}
  .overlay.show{opacity:1;visibility:visible;}
  .sheet{position:fixed;left:0;right:0;bottom:0;z-index:60;background:#fff;border-radius:18px 18px 0 0;
    padding:16px 16px calc(16px + env(safe-area-inset-bottom));transform:translateY(100%);transition:transform .28s ease;
    max-width:540px;margin:0 auto;box-shadow:0 -4px 20px rgba(0,0,0,.12);}
  .sheet.show{transform:translateY(0);}
  .sheet-head{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
  .sheet-head .s-title{font-size:16px;font-weight:800;flex:1;}
  .sheet-head .s-close{font-size:20px;color:var(--sub);cursor:pointer;padding:4px 8px;}

  /* 更多 右侧滑入面板 */
  .drawer{position:fixed;top:0;right:0;bottom:0;z-index:60;width:84%;max-width:360px;background:#fff;
    transform:translateX(100%);transition:transform .28s ease;box-shadow:-4px 0 20px rgba(0,0,0,.12);
    display:flex;flex-direction:column;}
  .drawer.show{transform:translateX(0);}
  .drawer-head{display:flex;align-items:center;gap:10px;padding:16px;border-bottom:1px solid var(--line);}
  .drawer-head .d-title{font-size:16px;font-weight:800;flex:1;}
  .drawer-head .d-close{font-size:20px;color:var(--sub);cursor:pointer;padding:4px 8px;}
  .menu-list{padding:10px 12px;}
  .menu-item{display:flex;align-items:center;gap:12px;padding:14px 12px;border-radius:12px;font-size:15px;
    font-weight:600;cursor:pointer;color:var(--txt);transition:.18s;background:var(--card);border:1px solid var(--line);margin-bottom:8px;}
  .menu-item:active{background:#f5f8ff;}
  .menu-item .mi-ic{font-size:18px;}
  .menu-body{flex:1;overflow:auto;padding:14px 16px 24px;}
  .menu-body.hide{display:none;}
  #toolBody{max-height:72vh;overflow:auto;}
  .menu-back{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--pri);
    cursor:pointer;font-weight:600;margin-bottom:10px;}

  .addr-row{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--line);
    border-radius:12px;margin-bottom:10px;background:#fff;}
  .addr-row .addr-url{font-size:13px;color:var(--txt);word-break:break-all;margin-top:4px;}
  .mod-list{margin-top:6px;}
  .mod-item{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--line);
    border-radius:12px;margin-bottom:10px;font-size:14px;font-weight:600;color:var(--txt);}
  .mod-item .mod-ic{font-size:20px;}

  /* 维修解绑模块 - 移动端专用样式 */
  .unbind-wrap{display:flex;flex-direction:column;height:100%;}
  .unbind-card{background:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.08);padding:14px;margin-bottom:12px;}
  .unbind-row{display:flex;align-items:center;margin-bottom:10px;}
  .unbind-row:last-child{margin-bottom:0;}
  .unbind-row label{width:30%;font-size:14px;color:#606266;font-weight:500;padding-right:8px;white-space:nowrap;}
  .unbind-row input{flex:1;width:70%;height:44px;padding:0 12px;border:1px solid #dcdfe6;border-radius:6px;font-size:15px;outline:none;background:#fff;color:#303133;}
  .unbind-row input:focus{border-color:#1890ff;}
  .unbind-row input::placeholder{color:#c0c4cc;}
  .unbind-list{flex:1;overflow:auto;padding-bottom:80px;}
  .unbind-item{display:flex;align-items:flex-start;gap:10px;background:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.08);padding:12px 14px;margin-bottom:10px;border:2px solid transparent;}
  .unbind-item.sel{border-color:#1890ff;background:#f0f7ff;}
  .ub-chk{flex:0 0 auto;padding-top:2px;}
  .ub-chk input{width:20px;height:20px;margin:0;}
  .ub-body{flex:1 1 auto;min-width:0;}
  .unbind-item-line{font-size:14px;color:#303133;line-height:1.6;word-break:break-all;margin-bottom:4px;}
  .unbind-item-line label{color:#909399;font-size:13px;margin-right:6px;}
  .ub-prod{color:#606266;}
  .unbind-item-time{font-size:13px;color:#909399;margin-top:6px;text-align:right;}
  .unbind-bottom{position:fixed;bottom:0;left:0;right:0;z-index:100;display:flex;height:56px;background:#fff;box-shadow:0 -2px 8px rgba(0,0,0,.08);max-width:540px;margin:0 auto;}
  .unbind-bottom button{flex:1;border:none;font-size:15px;font-weight:700;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;min-height:56px;}
  .unbind-bottom button:active{opacity:.88;}
  .unbind-bottom .btn-search{background:#1890ff;}
  .unbind-bottom .btn-outer{background:#fa8c16;}
  .unbind-bottom .btn-repair{background:#f5222d;}
  .unbind-bottom .btn-usage{background:#722ed1;}
  .unbind-empty{text-align:center;color:#909399;font-size:14px;padding:30px 0;}
  /* 错误横幅：区分网络不通/中转未起/目标系统不通/鉴权过期/超时 */
  .unbind-error{border-radius:10px;padding:18px 16px;margin:16px 12px;text-align:center;border:1px solid;}
  .unbind-error .ue-icon{font-size:36px;display:block;margin-bottom:8px;}
  .unbind-error .ue-title{font-size:16px;font-weight:700;display:block;margin-bottom:6px;}
  .unbind-error .ue-detail{font-size:13px;line-height:1.5;display:block;word-break:break-all;}
  .unbind-error.e-network{background:#fff2f0;border-color:#ffccc7;}
  .unbind-error.e-network .ue-title{color:#cf1322;}
  .unbind-error.e-network .ue-detail{color:#8c1414;}
  .unbind-error.e-proxy{background:#fff7e6;border-color:#ffd591;}
  .unbind-error.e-proxy .ue-title{color:#d46b08;}
  .unbind-error.e-proxy .ue-detail{color:#873800;}
  .unbind-error.e-target{background:#fff2f0;border-color:#ffccc7;}
  .unbind-error.e-target .ue-title{color:#cf1322;}
  .unbind-error.e-target .ue-detail{color:#8c1414;}
  .unbind-error.e-auth{background:#f6ffed;border-color:#b7eb8f;}
  .unbind-error.e-auth .ue-title{color:#389e0d;}
  .unbind-error.e-auth .ue-detail{color:#237804;}
  .unbind-error.e-timeout{background:#fffbe6;border-color:#ffe58f;}
  .unbind-error.e-timeout .ue-title{color:#ad6800;}
  .unbind-error.e-timeout .ue-detail{color:#614700;}
  .unbind-error.e-server{background:#fff1f0;border-color:#ffa39e;}
  .unbind-error.e-server .ue-title{color:#cf1322;}
  .unbind-error.e-server .ue-detail{color:#8c1414;}
  /* 使用记录面板 */
  .usage-log{padding:0;}
  .usage-item{display:flex;gap:10px;padding:12px;border-bottom:1px solid var(--line);}
  .usage-item:last-child{border-bottom:none;}
  .usage-ic{font-size:20px;flex:0 0 auto;width:28px;text-align:center;}
  .usage-body{flex:1;min-width:0;}
  .usage-head{display:flex;align-items:center;gap:8px;margin-bottom:4px;}
  .usage-act{font-size:14px;font-weight:600;color:var(--txt);}
  .usage-time{font-size:12px;color:var(--sub);margin-left:auto;white-space:nowrap;}
  .usage-desc{font-size:13px;color:#606266;line-height:1.5;word-break:break-all;}
  .usage-badge{display:inline-block;font-size:11px;padding:1px 7px;border-radius:4px;font-weight:600;}
  .usage-badge.ok{background:#f6ffed;color:#389e0d;border:1px solid #b7eb8f;}
  .usage-badge.fail{background:#fff2f0;color:#cf1322;border:1px solid #ffccc7;}
  .usage-clear{margin:16px 0;padding:10px 16px;text-align:center;font-size:14px;color:#ff4d4f;border:1px solid #ffa39e;border-radius:10px;cursor:pointer;background:#fff1f0;}
  .usage-clear:active{background:#ffccc7;}
  .unbind-meta{display:flex;align-items:center;gap:8px;font-size:13px;color:#909399;margin-bottom:10px;}
  .unbind-hint{font-size:12px;color:#909399;line-height:1.5;margin-top:8px;padding:8px;background:#f5f7fa;border-radius:6px;}
  /* 扫码按钮 + 取景弹层 */
  .ub-scan{width:40px;height:40px;margin-left:8px;flex:0 0 auto;border:1px solid #dcdfe6;border-radius:6px;background:#f5f7fa;font-size:18px;line-height:40px;cursor:pointer;padding:0;}
  .ub-scan:active{background:#e9eef5;}
  .scan-modal{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.92);display:none;flex-direction:column;align-items:center;justify-content:center;}
  .scan-modal.show{display:flex;}
  .scan-wrap{position:relative;width:84vw;max-width:420px;height:84vw;max-height:420px;}
  .scan-video{width:100%;height:100%;object-fit:cover;border-radius:12px;background:#000;}
  .scan-frame{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:70%;height:70%;border:2px solid #1890ff;box-shadow:0 0 0 9999px rgba(0,0,0,.55);border-radius:10px;pointer-events:none;}
  .scan-msg{color:#fff;font-size:14px;margin-top:16px;text-align:center;padding:0 20px;line-height:1.6;}
  .scan-close{margin-top:18px;border:none;background:#1890ff;color:#fff;font-size:15px;font-weight:700;padding:10px 26px;border-radius:24px;cursor:pointer;}
  .scan-close:active{opacity:.88;}
  .scan-capture{margin-top:12px;border:none;background:#52c41a;color:#fff;font-size:15px;font-weight:700;padding:10px 26px;border-radius:24px;cursor:pointer;}
  .scan-capture:active{opacity:.88;}
  .scan-capture:disabled{background:#999;}

  /* ===== 不良履历查询模块：结果行 + 批量操作 ===== */
  /* 自动分析提醒条（每月 2 号生成上月报告后提示查看/下载） */
  .dh-reminder{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;
    padding:9px 12px;margin:0 0 10px;background:#eff6ff;border:1px solid rgba(37,99,235,.25);border-radius:10px;
    font-size:13px;color:#1d4ed8;}
  .dh-reminder .dh-rem-go{color:#2563eb;font-weight:700;text-decoration:underline;cursor:pointer;padding:2px 6px;}
  .dh-batch-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
    padding:8px 10px;margin:0 0 8px;background:#f8fafc;border:1px solid var(--line);border-radius:10px;}
  .dh-batch-bar .btn.sm{padding:7px 12px;font-size:12.5px;}
  /* 隧道健康条已移除（用户反馈取消外网隧穿提示） */
  .dh-sel-all{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;color:var(--txt);font-weight:600;cursor:pointer;}
  .dh-sel-all input{width:16px;height:16px;cursor:pointer;}
  .dh-sel-count{margin-left:auto;font-size:12.5px;color:var(--sub);}
  .dh-row{display:flex;align-items:flex-start;gap:8px;
    background:#f8fafc;border:1px solid var(--line);border-radius:10px;padding:10px;margin-bottom:8px;transition:.15s;}
  .dh-row-sel{background:#fff8f5;border-color:rgba(220,38,38,.35);}
  .dh-row .dh-cb{flex:none;width:18px;height:18px;margin-top:2px;cursor:pointer;}
  .dh-row-text{flex:1;min-width:0;}
  .dh-row-img{flex:none;display:flex;align-items:center;justify-content:center;
    min-width:130px;max-width:160px;min-height:90px;}
  .dh-row-img img.dh-thumb{display:block;width:100%;max-width:160px;max-height:220px;
    object-fit:contain;border-radius:8px;border:1px solid var(--line);cursor:pointer;background:#fff;}
  .dh-row-img .tag{padding:6px 12px;}
  /* 图片加载态 / 错误态 */
  .dh-img-wrap{position:relative;display:flex;align-items:center;justify-content:center;
    min-width:130px;min-height:90px;}
  .dh-img-wrap img.dh-thumb{display:block;width:100%;max-width:160px;max-height:220px;
