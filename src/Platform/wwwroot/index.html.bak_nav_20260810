  img.alt = '不良图';
  // 调试信息：让用户可现场核对"图片对应行"（如仍有错配可一键定位）
  const hint = document.createElement('div');
  hint.style.cssText = 'color:#cbd5e1;font-size:11.5px;text-align:center;line-height:1.6;';
