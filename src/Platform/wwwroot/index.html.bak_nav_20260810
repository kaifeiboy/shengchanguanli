      if (cb.checked) dhSelected.add(k); else dhSelected.delete(k);
      const row = cb.closest('.dh-row');
      if (row) row.classList.toggle('dh-row-sel', cb.checked);
      dhUpdateBatchBar(box, allKeys);
    });
  });
  // 工具栏事件
  const allCb = $('#dhSelAll', box); if (allCb) allCb.onchange = (e) => dhSetAllChecked(box, allKeys, !!e.target.checked);
  const invBtn = $('#dhSelInv', box); if (invBtn) invBtn.onclick = () => dhSetAllChecked(box, allKeys, null);
  const clrBtn = $('#dhSelClr', box); if (clrBtn) clrBtn.onclick = () => dhSetAllChecked(box, allKeys, false);
  const batchBtn = $('#dhBatchDel', box); if (batchBtn) batchBtn.onclick = dhBatchDelete;
  // 新一次查询：清掉与新结果不重合的旧选择（保持新结果里仍勾选的）
  for (const k of Array.from(dhSelected)) if (!allKeys.includes(k)) dhSelected.delete(k);
  // 恢复勾选状态 + 高亮
  box.querySelectorAll('.dh-cb').forEach(cb => {
    if (dhSelected.has(cb.dataset.key)) { cb.checked = true; cb.closest('.dh-row').classList.add('dh-row-sel'); }
  });
  dhUpdateBatchBar(box, allKeys);
}

function dhSetAllChecked(box, allKeys, checked){
  box.querySelectorAll('.dh-cb').forEach(cb => {
    if (allKeys.includes(cb.dataset.key)){
      const want = (checked === null) ? !cb.checked : checked;
      if (cb.checked !== want){ cb.checked = want; cb.dispatchEvent(new Event('change')); }
    }
  });
}

function dhUpdateBatchBar(box, allKeys){
  const inResult = Array.from(dhSelected).filter(k => allKeys.includes(k));
  $('#dhSelCount', box).textContent = '已选 ' + inResult.length + ' 条';
  const total = allKeys.length;
  $('#dhBatchDel', box).disabled = inResult.length === 0;
  const allCb = $('#dhSelAll', box);
  if (allCb) allCb.checked = total > 0 && inResult.length === total;
  else if (allCb) allCb.checked = false;
}

async function dhBatchDelete(){
  // 单 Sheet 汇总表：key = 数据行索引
  const items = Array.from(dhSelected).map(k => ({ row: parseInt(k, 10) }));
  if (items.length === 0) return;
  const preview = items.slice(0, 3).map(i => '第' + (i.row + 1) + '行').join('\n');
  const more = items.length > 3 ? '\n... 等共 ' + items.length + ' 条' : '';
  if (!confirm('确定批量删除这 ' + items.length + ' 条不良记录？\n\n' + preview + more + '\n\n每条删除前会自动备份 (.bak)。')) return;
  let ok = 0, bad = 0, firstErr = '';
  toast('开始批量删除 ' + items.length + ' 条…');
  for (const it of items){
    try{
      const r = await (await fetch(dhAPI('delete'), {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify(it)
      })).json();
      if (r.ok) ok++; else { bad++; if (!firstErr) firstErr = r.error || '未知'; }
    }catch(e){ bad++; if (!firstErr) firstErr = e.message || String(e); }
  }
  dhSelected.clear();
  toast('批量删除完成：成功 ' + ok + (bad ? ' / 失败 ' + bad + (firstErr ? '（' + firstErr + '）' : '') : ''));
  if (dhLastQuery) dhDoQuery();
}

