  img.onerror = () => {
    spin.remove();
    img.remove();
    const err = document.createElement('div');
    err.style.cssText = 'color:#fca5a5;font-size:14px;font-weight:600;padding:14px 18px;border:1px dashed rgba(252,165,165,.5);border-radius:10px;background:rgba(30,20,20,.5);cursor:pointer;';
    err.textContent = '⚠️ 图片加载失败，点此重试';
    err.onclick = () => { err.remove(); ov.appendChild(spin); const n = new Image(); n.src = src + '&t=' + Date.now(); n.onload = () => { loaded = true; spin.remove(); ov.insertBefore(n, hint); n.style.cssText = img.style.cssText; }; n.onerror = () => { spin.remove(); err.textContent = '加载失败，请检查网络后重试'; ov.appendChild(err); }; };
    ov.appendChild(err);
  };
  img.src = src;
  ov.onclick = () => ov.remove();
  document.body.appendChild(ov);
}

