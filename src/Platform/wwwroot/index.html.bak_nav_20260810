// ---- 图纸列表 / 模糊搜索（图纸库 + 拍照比对 选图纸 共用）----
async function loadDrawings(box, onSelect){
  box.innerHTML='<div class="meta-line"><span class="spinner"></span> 加载中…</div>';
  try{
    const list = await (await fetch('api/drawings')).json();
    renderList(box, list, onSelect);
  }catch(e){ box.innerHTML='<div class="empty">加载失败：'+(e.message||e)+'</div>'; }
}
function renderList(box, list, onSelect){
  if(!list || !list.length){ box.innerHTML='<div class="empty">暂无图纸，请先初始化图纸库</div>'; return; }
  box.innerHTML = list.map(m=>`
    <div class="item" data-id="${m.id}">
      <div class="meta">
        <div class="fn">${esc(m.fileName)}</div>
        <div class="md">型号：<b style="color:var(--txt)">${esc(m.model||'-')}</b></div>
      </div>
      <span style="color:var(--sub)">选择 ›</span>
    </div>`).join('');
  box.querySelectorAll('.item[data-id]').forEach(el=>{
    el.onclick=()=> onSelect(parseInt(el.dataset.id,10));
  });
}
function bindSearch(inputEl, box, onSelect){
  let _t;
  inputEl.oninput = (e)=>{
    const q = e.target.value.trim();
    clearTimeout(_t);
    _t = setTimeout(async ()=>{
      if(!q){ loadDrawings(box, onSelect); return; }
      box.innerHTML='<div class="meta-line"><span class="spinner"></span> 模糊匹配中…</div>';
      try{
        const list = await (await fetch('api/drawings/search?q='+encodeURIComponent(q))).json();
        renderList(box, list, onSelect);
      }catch(err){ box.innerHTML='<div class="empty">搜索失败：'+(err.message||err)+'</div>'; }
    }, 250);
  };
}

