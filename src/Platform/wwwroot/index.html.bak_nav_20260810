function openSheet(action){
  pendingAction = action;
  $('#pickerSearch').value='';
  $('#overlay').classList.add('show');
  $('#sheet').classList.add('show');
  loadDrawings($('#pickerList'), onPick);
}
function closeSheet(){
  $('#sheet').classList.remove('show');
  $('#overlay').classList.remove('show');
