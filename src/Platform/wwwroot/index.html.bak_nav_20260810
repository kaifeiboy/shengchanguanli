function dhLastMonthStr(){
  const d = new Date(); d.setDate(1); d.setMonth(d.getMonth() - 1);
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
}

function dhPageAnalysis(preMonth){
  const root = $('#moduleRoot');
  root.style.justifyContent = 'flex-start'; root.style.paddingTop = '6px';
  const defMonth = preMonth || dhLastMonthStr();
  root.innerHTML = dhBackBar('数据分析') + `
    <div class="card">
      <div class="entry-row" style="gap:10px;">
        <div style="flex:1;">
          <label class="fld">月份（单选）</label>
          <select id="dhAnMonth" style="width:100%;padding:11px 12px;border-radius:12px;border:1px solid var(--line);font-size:15px;background:#fff;color:var(--txt);">
            <option value="">加载中…</option>
          </select>
        </div>
        <div style="flex:1;">
          <label class="fld">型号（留空=全部）</label>
          <input type="text" id="dhAnModel" placeholder="如 FD01" autocomplete="off" />
        </div>
      </div>
      <button class="btn" style="margin-top:12px;" id="dhAnBtn">📊 生成分析</button>
      <button class="btn ghost" style="margin-top:8px;" id="dhAnExport">📥 导出分析文档（DOCX · 可编辑 · A4 打印）</button>
    </div>
    <div class="card" id="dhAnChartCard" style="display:none;">
      <h3 id="dhAnTitle" style="font-size:15px;"></h3>
      <div style="position:relative;margin-top:12px;"><canvas id="dhAnCanvas" style="width:100%;height:300px;display:block;"></canvas></div>
      <div id="dhAnLegend" style="margin-top:10px;font-size:12.5px;color:var(--sub);display:flex;flex-wrap:wrap;gap:14px;justify-content:center;"></div>
      <div class="meta-line" id="dhAnEmpty" style="display:none;color:var(--sub);text-align:center;">该月无不良数据</div>
    </div>`;
  $('#dhBack').onclick = dhRenderMenu;
  const sel = $('#dhAnMonth');
  const fillSel = (ms) => {
    sel.innerHTML = '<option value="">全部月份</option>' +
      ms.map(x=>`<option value="${esc(x.month)}">${esc(x.month)}（${x.count||0} 条）</option>`).join('');
    sel.value = (ms.some(x=>x.month===defMonth)) ? defMonth : (ms[0] ? ms[0].month : '');
  };
  if (dhMonths.length) { fillSel(dhMonths); }
  else {
    fetch(dhAPI('meta')).then(r=>r.json()).then(m => {
      dhMonths = (m.months || []);
      fillSel(dhMonths);
    }).catch(()=>{ sel.innerHTML = '<option value="">加载失败</option>'; });
  }
  $('#dhAnBtn').onclick = dhRunAnalysis;
  $('#dhAnExport').onclick = dhExportAnalysis;
  $('#dhAnModel').addEventListener('keydown', e => { if(e.key==='Enter') dhRunAnalysis(); });
  if (preMonth) dhRunAnalysis();
}

async function dhRunAnalysis(){
  const month = ($('#dhAnMonth').value || '').trim();
  if (!/^\d{4}-\d{2}$/.test(month)){ toast('月份格式应为 YYYY-MM'); return; }
  const model = ($('#dhAnModel').value || '').trim();
  const card = $('#dhAnChartCard'); card.style.display = 'block';
  $('#dhAnEmpty').style.display = 'none';
  $('#dhAnTitle').textContent = '加载中…';
  let r;
  try{
    r = await (await fetch(dhAPI('analysis?month=' + dhEnc(month) + (model ? '&model=' + dhEnc(model) : '')))).json();
  }catch(e){ $('#dhAnTitle').textContent = '分析失败：' + (e.message || e); return; }
  if (!r.ok){ $('#dhAnTitle').textContent = r.error || '分析失败'; return; }
  $('#dhAnTitle').textContent = r.title;
  const data = r.data || [];
  if (data.length === 0){ $('#dhAnEmpty').style.display = 'block'; $('#dhAnLegend').innerHTML = ''; return; }
  dhDrawAnalysisChart(r);
}

// 型号配色板（与后端导出图表一致）
const DH_MODEL_COLORS = ['#4472C4','#ED7D31','#70AD47','#FFC000','#7030A0','#E84C3D','#2E9BD9','#C00000','#00B0F0','#7F7F7F'];

// Canvas 堆叠柱状图：X=拉线；单柱=该拉线当月不良总单数，柱内按型号分段着色（颜色=型号）；
// 每个拉线的型号说明（色块+型号名）放置在该拉线正下方（不再使用集中式文本图例）。
function dhDrawAnalysisChart(r){
  const data = r.data || [], lines = r.lines || [], models = r.models || [];
  const colorOf = {};
  models.forEach((m, i) => { colorOf[m] = DH_MODEL_COLORS[i % DH_MODEL_COLORS.length]; });
  const groups = {};
  data.forEach(d => { (groups[d.line] = groups[d.line] || []).push(d); });
  const byModel = (a, b) => (models.indexOf(a.model) - models.indexOf(b.model));
  const canvas = $('#dhAnCanvas');
  const dpr = window.devicePixelRatio || 1;
  const cssW = canvas.clientWidth || 320;
  const cssH = 300;
  canvas.width = cssW * dpr; canvas.height = cssH * dpr;
  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, cssW, cssH);
  // 型号文本折行：按 Canvas 实测宽度切行（规则与 docx _wrap_label 一致：完整显示不截断）
  const wrapTxt = (txt, maxW) => {
    ctx.font = '11px sans-serif';
    const out = []; let cur = '';
    for (const ch of String(txt || '')){
      if (cur && ctx.measureText(cur + ch).width > maxW){ out.push(cur); cur = ch; }
      else cur += ch;
    }
    if (cur) out.push(cur);
    return out.length ? out : [''];
  };
  // 底部标注区高度：按每拉线"型号折行后总行数"的最大值定（每行 15px，至少 1 行/型号）
  const plotW0 = cssW - 48;
  const slot0 = plotW0 / Math.max(1, lines.length);
  const textMaxW = slot0 - 26;
  const maxRows = Math.max.apply(null, lines.map(line => {
    const items = (groups[line] || []).slice().sort(byModel);
    return items.reduce((s, d) => s + wrapTxt(d.model, textMaxW).length, 0);
  })) || 0;
  const M = { l: 34, r: 14, t: 16, b: 58 + maxRows * 15 };
  canvas.style.height = cssH + 'px';
  const plotW = cssW - M.l - M.r, plotH = cssH - M.t - M.b;
  const maxTotal = Math.max.apply(null, data.map(d => d.total)) || 1;
  const yMax = Math.max(5, Math.ceil(maxTotal / 5) * 5);
  // 网格 + Y 轴
  ctx.font = '11px sans-serif';
  ctx.fillStyle = '#64748b';
  ctx.strokeStyle = '#e2e8f0'; ctx.lineWidth = 1;
  for (let i = 0; i <= 5; i++){
    const y = M.t + plotH - (i / 5) * plotH;
    ctx.beginPath(); ctx.moveTo(M.l, y); ctx.lineTo(M.l + plotW, y); ctx.stroke();
    ctx.fillText(String(Math.round(yMax * i / 5)), 4, y + 4);
  }
  const groupSlot = plotW / Math.max(1, lines.length);
  // 堆叠柱状图：每根柱=该拉线当月不良总单数，柱内按型号分段着色（颜色=型号）
  lines.forEach((line, gi) => {
    const items = (groups[line] || []).slice().sort(byModel);
    const gx = M.l + groupSlot * gi;
    const gw = groupSlot - 8;
    if (items.length === 0) return;
    const barW = Math.min(46, gw * 0.55);
    const cx = gx + gw / 2;
    const x = cx - barW / 2;
    const baseY = M.t + plotH;
    let acc = 0;
    items.forEach(d => {
      const h = (d.total / yMax) * plotH;
      ctx.fillStyle = colorOf[d.model] || '#999';
      ctx.fillRect(x, baseY - acc - h, barW, h);
      acc += h;
    });
    // 柱顶总单数标签
    const total = items.reduce((s, d) => s + d.total, 0);
    if (total > 0){
      ctx.fillStyle = '#1e293b';
      ctx.font = 'bold 11px sans-serif';
      ctx.fillText(String(total), cx, baseY - acc - 4);
      ctx.font = '11px sans-serif';
    }
    // 柱下标注（恢复原版式）：拉线名（6 字符截断）+ 型号 色块+名称（完整显示，超宽自动折行）
    ctx.textAlign = 'center';
    ctx.font = '11px sans-serif';
    let lbl = line;
    if (lbl.length > 6) lbl = lbl.slice(0, 5) + '…';
    const labelY = cssH - M.b + 13;
    ctx.fillStyle = '#334155';
    ctx.fillText(lbl, cx, labelY);
    let ry = labelY + 16;
    items.forEach(d => {
      const ws = wrapTxt(d.model, textMaxW);
      ws.forEach((ln, li) => {
        const y = ry + li * 15;
        if (li === 0){
          ctx.fillStyle = colorOf[d.model] || '#999';
          ctx.fillRect(cx - 26, y - 8, 9, 9);
        }
        ctx.fillStyle = '#475569';
        ctx.textAlign = 'left';
        ctx.fillText(ln, cx - 13, y);
      });
      ry += ws.length * 15;
    });
  });
  // 型号说明已随柱下标注展示，移除集中式文本图例
  $('#dhAnLegend').innerHTML = '';
}

function dhExportAnalysis(){
  const month = ($('#dhAnMonth').value || '').trim();
  if (!/^\d{4}-\d{2}$/.test(month)){ toast('请先选择有效月份'); return; }
  const model = ($('#dhAnModel').value || '').trim();
  window.open(dhAPI('analysis/export?month=' + dhEnc(month) + (model ? '&model=' + dhEnc(model) : '')), '_blank');
  toast('分析图表导出中…');
}

// ---- 启动 ----
loadModules(); loadNet();
// 深链接支持：?mod=defecthistory&model=YCWA15NCWQ&month=2026-03 直达查询（可分享/可被自动化测试）
(function(){
  try{
    const qs = new URLSearchParams(location.search);
    const deepMod = qs.get('mod');
    const deepModel = qs.get('model');
    const deepPage = qs.get('page');
    if (deepMod && (deepModel || deepPage)){
      const _ok = setInterval(() => {
        if (modulesCache.length > 0){
          clearInterval(_ok);
          if (modulesCache.find(m => m.key === deepMod)){
            activateModule(deepMod);
            setTimeout(() => {
              if (deepMod === 'defecthistory'){
                if (deepPage === 'analysis'){
                  dhPageAnalysis(qs.get('month') || undefined);   // 直达数据分析页并自动生成
                  return;
                }
                dhPageQuery();                       // 直接进查询页（activateModule 只渲染菜单）
                const el = $('#dhQModel');
                if (el){
                  el.value = deepModel;
                  const m = qs.get('month');
                  if (m){ const sel = $('#dhQMonth'); if (sel && Array.from(sel.options).some(o => o.value === m)) sel.value = m; }
                  dhDoQuery();
                }
              }
            }, 350);
          }
        }
      }, 150);
    }
  }catch(e){ /* 深链接失败不影响正常使用 */ }
})();
</script>

