<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF OCR 脚本随附输出目录，OcrService 默认从此加载 -->
    <None Update="pdf_ocr.py" CopyToOutputDirectory="PreserveNewest" />
    <!-- 库存尾数模块（v2 独立重建）Python 脚本：拍照识别 / 明细导出 -->
    <None Update="Modules\InvTail\inv_ocr.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Modules\InvTail\inv_export.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- H5 静态资源（wwwroot）随附输出目录：Production 模式下 UseStaticFiles 从 bin 目录读取，必须物理复制。
         SDK 默认已含 wwwroot 的 Content 项，但不会复制到输出；用 Update 改其 CopyToOutputDirectory 即可。 -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
